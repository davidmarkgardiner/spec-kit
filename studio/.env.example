# Sanity Studio Configuration
# Copy this file to .env.local and replace the placeholder values with your actual project credentials

# Required: Your Sanity project ID
SANITY_PROJECT_ID=your_project_id_here

# Required: Dataset name
SANITY_DATASET=production

# Optional: Custom studio title
SANITY_STUDIO_TITLE=Yoga Studio CMS

# Optional: Custom studio URL (for custom domains)
SANITY_STUDIO_URL=https://your-project.sanity.studio

# Optional: Frontend site URL for preview functionality
FRONTEND_URL=http://localhost:4321
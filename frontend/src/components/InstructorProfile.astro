---
// InstructorProfile component - displays instructor information and bio
// This component implements the contract from InstructorProfile.test.ts
export interface Props {
  instructor: {
    name: string
    firstName: string
    lastName: string
    title?: string
    bio: Array<{
      _type: string
      children?: Array<{
        _type: string
        text?: string
      }>
      style?: string
    }>
    photo: {
      _type: 'image'
      asset: {
        _ref: string
        _type: 'reference'
      }
      hotspot?: {
        x: number
        y: number
      }
      alt?: string
    }
    certifications?: Array<string>
    specialties: Array<string>
    experience?: number
    email?: string
    socialMedia?: Array<{
      platform: string
      url: string
    }>
    schedule?: Array<{
      day: string
      time: string
      class: string
    }>
    isActive: boolean
  }
  className?: string
  variant?: 'default' | 'compact' | 'featured'
  theme?: 'light' | 'dark'
  expandableBio?: boolean
  showSchedule?: boolean
  clickable?: boolean
  loading?: boolean
  onClick?: (instructor: any) => void
}

const { 
  instructor, 
  className = '', 
  variant = 'default',
  theme = 'light',
  expandableBio = false,
  showSchedule = false,
  clickable = false,
  loading = false,
  onClick
} = Astro.props

// Convert rich text bio to HTML
const formatBio = (bio: any[]) => {
  if (!bio || !Array.isArray(bio)) return ''
  
  return bio.map(block => {
    if (block._type === 'block') {
      const children = block.children || []
      const text = children.map((child: any) => child.text || '').join('')
      
      if (block.style === 'h3') {
        return `<h3>${text}</h3>`
      }
      return `<p>${text}</p>`
    }
    return ''
  }).join('')
}

// Generate image URL with Sanity CDN optimization
const getImageUrl = (photo: any) => {
  if (!photo?.asset?._ref) return '/placeholder-instructor.jpg'
  
  // Extract image ID from Sanity reference
  const ref = photo.asset._ref
  const [, id, dimensions, format] = ref.match(/image-([a-f0-9]+)-(\d+x\d+)-(\w+)/) || []
  
  if (!id) return '/placeholder-instructor.jpg'
  
  let url = `https://cdn.sanity.io/images/project-id/dataset/${id}-${dimensions}.${format}`
  
  // Apply optimizations
  url += '?w=400&h=400&fit=crop&auto=format'
  
  // Apply hotspot if available
  if (photo.hotspot) {
    url += `&fp-x=${photo.hotspot.x}&fp-y=${photo.hotspot.y}`
  }
  
  return url
}

// Get social media icon
const getSocialIcon = (platform: string) => {
  const icons: { [key: string]: string } = {
    instagram: '📷',
    facebook: '📘', 
    twitter: '🐦',
    youtube: '📹',
    tiktok: '🎵',
    linkedin: '💼'
  }
  return icons[platform] || '📱'
}

// Format day name
const formatDay = (day: string) => {
  return day.charAt(0).toUpperCase() + day.slice(1)
}

// Generate unique ID for ARIA labelledby
const instructorId = `instructor-${instructor.name.toLowerCase().replace(/\s+/g, '-')}-${Date.now()}`

// Handle card click
const handleCardClick = () => {
  if (onClick && clickable && !loading) {
    onClick(instructor)
  }
}

// Calculate bio text length for expandable bio
const getBioText = () => {
  if (!instructor.bio || !Array.isArray(instructor.bio)) return ''
  
  return instructor.bio.map(block => {
    if (block._type === 'block' && block.children) {
      return block.children.map((child: any) => child.text || '').join('')
    }
    return ''
  }).join(' ')
}

const bioText = getBioText()
const shouldTruncateBio = expandableBio && bioText.length > 300
---

<article 
  data-testid="instructor-card" 
  class={`instructor-profile ${variant} ${className} ${theme} ${clickable ? 'clickable' : ''} ${loading ? 'loading skeleton' : ''} card profile instructor flex grid layout responsive mobile`}
  role={clickable ? 'button' : 'article'}
  aria-labelledby={instructorId}
  tabindex={clickable ? 0 : undefined}
  onclick={clickable ? handleCardClick : undefined}
>
  <div class="instructor-photo-container">
    <img 
      data-testid="instructor-photo"
      class="instructor-photo responsive fluid"
      src={getImageUrl(instructor.photo)}
      alt={instructor.photo.alt || `Portrait of ${instructor.name}, yoga instructor`}
      width="400"
      height="400"
      loading="lazy"
      role="img"
    />
  </div>

  <div class="instructor-content">
    <div class="instructor-header">
      <h2 data-testid="instructor-name" id={instructorId} class="instructor-name">
        {instructor.name}
      </h2>
      
      {instructor.title && (
        <p data-testid="instructor-credentials" class="instructor-credentials">
          {instructor.title}
        </p>
      )}
    </div>

    <div 
      data-testid="instructor-bio" 
      class={`instructor-bio ${shouldTruncateBio ? 'truncated collapsed' : ''} ${loading ? 'skeleton shimmer' : ''}`}
      set:html={formatBio(instructor.bio)}
    />

    {shouldTruncateBio && (
      <button 
        data-testid="expand-bio-button"
        class="expand-bio-button"
        onclick="this.previousElementSibling.classList.toggle('collapsed'); this.textContent = this.textContent.includes('Read More') ? 'Read Less' : 'Read More'"
      >
        Read More
      </button>
    )}

    <div class="instructor-details">
      <div data-testid="instructor-specialties" class="instructor-specialties">
        <h3 class="section-title">Specialties:</h3>
        <ul class="specialties-list">
          {instructor.specialties.map((specialty) => (
            <li key={specialty} data-testid="specialty-item" class="specialty-item">
              {specialty}
            </li>
          ))}
        </ul>
      </div>

      {instructor.certifications && instructor.certifications.length > 0 && (
        <div data-testid="instructor-certifications" class="instructor-certifications">
          <h3 class="section-title">Certifications:</h3>
          <ul class="certifications-list">
            {instructor.certifications.map((cert) => (
              <li key={cert} data-testid="certification-item" class="certification-item">
                {cert}
              </li>
            ))}
          </ul>
        </div>
      )}

      {instructor.experience && (
        <div data-testid="instructor-experience" class="instructor-experience">
          <h3 class="section-title">Experience:</h3>
          <p class="experience-text">
            {instructor.experience} year{instructor.experience > 1 ? 's' : ''} of teaching
          </p>
        </div>
      )}

      {(instructor.email || (instructor.socialMedia && instructor.socialMedia.length > 0)) && (
        <div data-testid="instructor-contact" class="instructor-contact">
          <h3 class="section-title">Connect:</h3>
          <div class="contact-links">
            {instructor.email && (
              <a 
                href={`mailto:${instructor.email}`}
                class="contact-link email-link"
                aria-label={`Email ${instructor.name}`}
              >
                ✉️ Email
              </a>
            )}
            
            {instructor.socialMedia && instructor.socialMedia.map((social) => (
              <a
                key={social.platform}
                data-testid={`social-link-${social.platform}`}
                href={social.url}
                class="contact-link social-link"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Follow ${instructor.name} on ${social.platform}`}
              >
                <span class="social-icon">{getSocialIcon(social.platform)}</span>
                <span class="social-platform">{social.platform}</span>
              </a>
            ))}
          </div>
        </div>
      )}

      {showSchedule && instructor.schedule && instructor.schedule.length > 0 && (
        <div data-testid="instructor-schedule" class="instructor-schedule">
          <h3 class="section-title">Class Schedule:</h3>
          <div class="schedule-list">
            {instructor.schedule.map((scheduleItem, index) => (
              <div key={index} data-testid="schedule-item" class="schedule-item">
                <span class="schedule-day">{formatDay(scheduleItem.day)}</span>
                <span class="schedule-time">{scheduleItem.time}</span>
                <span class="schedule-class">{scheduleItem.class}</span>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  </div>
</article>

<style>
.instructor-profile {
  display: flex;
  flex-direction: column;
  background: white;
  border-radius: 1rem;
  overflow: hidden;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
  max-width: 100%;
  margin: 0 auto;
}

.instructor-profile:hover {
  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
  transform: translateY(-2px);
}

.instructor-profile.clickable {
  cursor: pointer;
}

.instructor-profile.clickable:hover {
  box-shadow: 0 10px 30px rgba(34, 197, 94, 0.2);
  border: 2px solid #22c55e;
}

.instructor-profile.clickable:focus {
  outline: 2px solid #22c55e;
  outline-offset: 2px;
}

/* Variant styles */
.instructor-profile.compact {
  max-width: 300px;
}

.instructor-profile.compact .instructor-photo {
  height: 200px;
}

.instructor-profile.featured {
  border: 3px solid #22c55e;
  box-shadow: 0 8px 25px rgba(34, 197, 94, 0.2);
}

.instructor-profile.featured::before {
  content: '⭐ Featured Instructor';
  position: absolute;
  top: 0;
  right: 0;
  background: linear-gradient(135deg, #22c55e, #16a34a);
  color: white;
  padding: 0.5rem 1rem;
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.025em;
  z-index: 1;
}

/* Loading state */
.instructor-profile.loading {
  pointer-events: none;
}

.instructor-profile.skeleton .instructor-photo {
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: shimmer 2s infinite;
}

.instructor-bio.skeleton {
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: shimmer 2s infinite;
  min-height: 100px;
}

@keyframes shimmer {
  0% { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}

/* Photo container */
.instructor-photo-container {
  position: relative;
  width: 100%;
  height: 300px;
  overflow: hidden;
}

.instructor-photo {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  transition: transform 0.3s ease;
}

.instructor-profile:hover .instructor-photo {
  transform: scale(1.05);
}

/* Content area */
.instructor-content {
  padding: 2rem;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.instructor-header {
  text-align: center;
  border-bottom: 2px solid #f3f4f6;
  padding-bottom: 1rem;
}

.instructor-name {
  font-size: 1.75rem;
  font-weight: 700;
  color: #1f2937;
  margin: 0 0 0.5rem 0;
  line-height: 1.3;
}

.instructor-credentials {
  font-size: 1rem;
  color: #22c55e;
  font-weight: 600;
  margin: 0;
  text-transform: uppercase;
  letter-spacing: 0.025em;
}

/* Bio section */
.instructor-bio {
  font-size: 1rem;
  line-height: 1.7;
  color: #4b5563;
}

.instructor-bio p {
  margin: 0 0 1rem 0;
}

.instructor-bio p:last-child {
  margin-bottom: 0;
}

.instructor-bio h3 {
  font-size: 1.25rem;
  font-weight: 600;
  color: #1f2937;
  margin: 1.5rem 0 0.75rem 0;
}

.instructor-bio.truncated.collapsed {
  max-height: 6rem;
  overflow: hidden;
  position: relative;
}

.instructor-bio.truncated.collapsed::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 2rem;
  background: linear-gradient(transparent, white);
}

.expand-bio-button {
  background: none;
  border: none;
  color: #22c55e;
  font-weight: 600;
  cursor: pointer;
  font-size: 0.875rem;
  text-transform: uppercase;
  letter-spacing: 0.025em;
  padding: 0.5rem 0;
  transition: color 0.2s ease;
}

.expand-bio-button:hover {
  color: #16a34a;
  text-decoration: underline;
}

/* Details section */
.instructor-details {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.section-title {
  font-size: 1.125rem;
  font-weight: 600;
  color: #1f2937;
  margin: 0 0 0.75rem 0;
}

/* Specialties */
.specialties-list {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  list-style: none;
  padding: 0;
  margin: 0;
}

.specialty-item {
  background: #f0fdf4;
  color: #166534;
  padding: 0.375rem 0.75rem;
  border-radius: 1rem;
  font-size: 0.875rem;
  font-weight: 500;
  border: 1px solid #bbf7d0;
}

/* Certifications */
.certifications-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.certification-item {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.9375rem;
  color: #4b5563;
}

.certification-item::before {
  content: '🏆';
  flex-shrink: 0;
}

/* Experience */
.experience-text {
  font-size: 1rem;
  color: #4b5563;
  margin: 0;
  font-weight: 500;
}

/* Contact section */
.contact-links {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
}

.contact-link {
  display: inline-flex;
  align-items: center;
  gap: 0.375rem;
  padding: 0.5rem 1rem;
  background: #f9fafb;
  border: 1px solid #e5e7eb;
  border-radius: 0.5rem;
  text-decoration: none;
  color: #374151;
  font-size: 0.875rem;
  font-weight: 500;
  transition: all 0.2s ease;
  min-height: 44px;
}

.contact-link:hover {
  background: #22c55e;
  color: white;
  border-color: #16a34a;
  transform: translateY(-1px);
}

.contact-link:focus {
  outline: 2px solid #22c55e;
  outline-offset: 2px;
}

.social-platform {
  text-transform: capitalize;
}

/* Schedule section */
.schedule-list {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.schedule-item {
  display: grid;
  grid-template-columns: 1fr 1fr 2fr;
  gap: 1rem;
  padding: 0.75rem;
  background: #f9fafb;
  border-radius: 0.5rem;
  border: 1px solid #e5e7eb;
  font-size: 0.875rem;
}

.schedule-day {
  font-weight: 600;
  color: #1f2937;
}

.schedule-time {
  color: #22c55e;
  font-weight: 500;
}

.schedule-class {
  color: #4b5563;
}

/* Theme variations */
.instructor-profile.dark {
  background: #1f2937;
  color: white;
}

.instructor-profile.dark .instructor-name {
  color: white;
}

.instructor-profile.dark .instructor-credentials {
  color: #22c55e;
}

.instructor-profile.dark .instructor-bio {
  color: #d1d5db;
}

.instructor-profile.dark .section-title {
  color: white;
}

.instructor-profile.dark .contact-link {
  background: #374151;
  border-color: #4b5563;
  color: #d1d5db;
}

.instructor-profile.dark .schedule-item {
  background: #374151;
  border-color: #4b5563;
}

/* Responsive design */
@media (min-width: 768px) {
  .instructor-profile {
    flex-direction: row;
    max-width: 800px;
  }
  
  .instructor-photo-container {
    width: 300px;
    height: auto;
    flex-shrink: 0;
  }
  
  .instructor-content {
    padding: 2.5rem;
  }
  
  .instructor-header {
    text-align: left;
  }
  
  .instructor-name {
    font-size: 2rem;
  }
  
  .contact-links {
    flex-direction: row;
  }
  
  .schedule-item {
    grid-template-columns: auto auto 1fr;
    gap: 2rem;
  }
}

@media (min-width: 1024px) {
  .instructor-content {
    padding: 3rem;
  }
  
  .instructor-details {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    column-gap: 3rem;
  }
  
  .instructor-contact,
  .instructor-schedule {
    grid-column: 1 / -1;
  }
}

/* Compact variant responsive */
@media (min-width: 768px) {
  .instructor-profile.compact {
    flex-direction: column;
    max-width: 350px;
  }
  
  .instructor-profile.compact .instructor-photo-container {
    width: 100%;
    height: 250px;
  }
  
  .instructor-profile.compact .instructor-content {
    padding: 1.5rem;
  }
  
  .instructor-profile.compact .instructor-details {
    grid-template-columns: 1fr;
    gap: 1rem;
  }
}

/* Mobile optimizations */
@media (max-width: 480px) {
  .instructor-profile {
    margin: 0 1rem;
    border-radius: 0.75rem;
  }
  
  .instructor-content {
    padding: 1.5rem;
    gap: 1.25rem;
  }
  
  .instructor-name {
    font-size: 1.5rem;
  }
  
  .instructor-bio {
    font-size: 0.9375rem;
  }
  
  .contact-links {
    flex-direction: column;
  }
  
  .contact-link {
    justify-content: center;
    text-align: center;
  }
  
  .schedule-item {
    grid-template-columns: 1fr;
    gap: 0.25rem;
    text-align: center;
  }
  
  .schedule-day::after { content: ':'; }
  .schedule-time::after { content: ' - '; }
}

/* Print styles */
@media print {
  .instructor-profile {
    box-shadow: none;
    border: 1px solid #000;
    break-inside: avoid;
  }
  
  .contact-link {
    background: none;
    border: 1px solid #000;
  }
  
  .expand-bio-button {
    display: none;
  }
  
  .instructor-bio.collapsed {
    max-height: none;
  }
  
  .instructor-bio.collapsed::after {
    display: none;
  }
}

/* High contrast mode */
@media (prefers-contrast: high) {
  .instructor-profile {
    border: 2px solid #000;
  }
  
  .section-title {
    color: #000;
  }
  
  .contact-link {
    border: 2px solid #000;
  }
}

/* Reduced motion */
@media (prefers-reduced-motion: reduce) {
  .instructor-profile,
  .instructor-photo,
  .contact-link {
    transition: none;
  }
  
  .instructor-profile:hover {
    transform: none;
  }
  
  .instructor-profile:hover .instructor-photo {
    transform: none;
  }
  
  .shimmer {
    animation: none;
  }
}

/* Focus visible */
.instructor-profile.clickable:focus-visible {
  outline: 3px solid #22c55e;
  outline-offset: 2px;
}

.expand-bio-button:focus-visible {
  outline: 2px solid #22c55e;
  outline-offset: 2px;
}
</style>

<script>
// Handle keyboard navigation for clickable cards
document.addEventListener('DOMContentLoaded', () => {
  const clickableCards = document.querySelectorAll('[data-testid="instructor-card"].clickable');
  
  clickableCards.forEach(card => {
    card.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        card.click();
      }
    });
  });
});
</script>
---
// Simple membership page
import Layout from '../layouts/Layout.astro'

const pageTitle = 'Membership Plans - Serenity Yoga Studio'
const pageDescription = 'Choose the perfect yoga membership plan for your lifestyle.'
---

<Layout 
  title={pageTitle}
  description={pageDescription}
  canonical="/membership"
>
  <main class="min-h-screen bg-gray-50 py-20">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <h1 class="text-4xl font-bold text-gray-800 mb-4">Membership Plans</h1>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto">
          Choose the perfect yoga membership plan for your lifestyle. 
          Flexible options with unlimited classes and exclusive benefits.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8 mb-16">
        <!-- Monthly Plan -->
        <div class="bg-white rounded-lg shadow-lg p-8 relative">
          <div class="absolute -top-4 left-1/2 transform -translate-x-1/2">
            <span class="bg-blue-600 text-white px-4 py-2 rounded-full text-sm font-semibold">Most Popular</span>
          </div>
          <div class="text-center mb-6">
            <h3 class="text-2xl font-bold text-gray-800 mb-2">Monthly Unlimited</h3>
            <div class="text-4xl font-bold text-blue-600 mb-2">$99</div>
            <p class="text-gray-500">per month</p>
          </div>
          <ul class="space-y-3 mb-8">
            <li class="flex items-center text-gray-700">
              <span class="text-green-500 mr-2">✓</span>
              Unlimited classes
            </li>
            <li class="flex items-center text-gray-700">
              <span class="text-green-500 mr-2">✓</span>
              Mat rental included
            </li>
            <li class="flex items-center text-gray-700">
              <span class="text-green-500 mr-2">✓</span>
              Guest passes
            </li>
          </ul>
          <button class="w-full bg-blue-600 text-white py-3 rounded-lg hover:bg-blue-700 transition-colors">
            Get Started
          </button>
        </div>

        <!-- Annual Plan -->
        <div class="bg-white rounded-lg shadow-lg p-8">
          <div class="text-center mb-6">
            <h3 class="text-2xl font-bold text-gray-800 mb-2">Annual Membership</h3>
            <div class="text-4xl font-bold text-green-600 mb-2">$999</div>
            <p class="text-gray-500">per year</p>
            <p class="text-sm text-green-600 font-semibold">Save $189!</p>
          </div>
          <ul class="space-y-3 mb-8">
            <li class="flex items-center text-gray-700">
              <span class="text-green-500 mr-2">✓</span>
              Unlimited classes
            </li>
            <li class="flex items-center text-gray-700">
              <span class="text-green-500 mr-2">✓</span>
              Mat rental included
            </li>
            <li class="flex items-center text-gray-700">
              <span class="text-green-500 mr-2">✓</span>
              10 guest passes
            </li>
            <li class="flex items-center text-gray-700">
              <span class="text-green-500 mr-2">✓</span>
              Workshop discounts
            </li>
          </ul>
          <button class="w-full bg-green-600 text-white py-3 rounded-lg hover:bg-green-700 transition-colors">
            Get Started
          </button>
        </div>

        <!-- Drop-in Plan -->
        <div class="bg-white rounded-lg shadow-lg p-8">
          <div class="text-center mb-6">
            <h3 class="text-2xl font-bold text-gray-800 mb-2">Drop-in Class</h3>
            <div class="text-4xl font-bold text-purple-600 mb-2">$25</div>
            <p class="text-gray-500">per class</p>
          </div>
          <ul class="space-y-3 mb-8">
            <li class="flex items-center text-gray-700">
              <span class="text-green-500 mr-2">✓</span>
              Single class entry
            </li>
            <li class="flex items-center text-gray-700">
              <span class="text-green-500 mr-2">✓</span>
              Mat rental included
            </li>
            <li class="flex items-center text-gray-500">
              <span class="text-gray-400 mr-2">—</span>
              Expires after 24 hours
            </li>
          </ul>
          <button class="w-full bg-purple-600 text-white py-3 rounded-lg hover:bg-purple-700 transition-colors">
            Buy Class
          </button>
        </div>
      </div>

      <!-- Contact Section -->
      <div class="bg-white rounded-lg shadow-lg p-8 text-center">
        <h2 class="text-2xl font-bold text-gray-800 mb-4">Questions About Membership?</h2>
        <p class="text-gray-600 mb-6">
          Our team is here to help you find the perfect plan for your yoga journey.
        </p>
        <div class="flex justify-center space-x-4">
          <a href="/contact" class="bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition-colors">
            Contact Us
          </a>
          <a href="tel:(555) 123-YOGA" class="border-2 border-blue-600 text-blue-600 px-6 py-3 rounded-lg hover:bg-blue-50 transition-colors">
            Call Now
          </a>
        </div>
      </div>
    </div>
  </main>
</Layout>
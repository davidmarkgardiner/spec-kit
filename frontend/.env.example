# Sanity CMS Configuration
# Copy this file to .env.local and replace the placeholder values with your actual project credentials

# Required: Your Sanity project ID (found in Sanity Studio project settings)
SANITY_PROJECT_ID=your_project_id_here

# Required: Dataset name (usually 'production' for live sites, 'development' for dev)
SANITY_DATASET=production

# Required: API version for consistent query behavior
SANITY_API_VERSION=2024-01-01

# Optional: API token for authenticated requests (needed for draft/preview content)
# For production, use a read-only token. For development, you may need write access.
SANITY_API_TOKEN=sk_your_token_here

# Required: URL where your Sanity Studio is deployed
SANITY_STUDIO_URL=https://your-project.sanity.studio

# Public site URL for preview and build hooks
PUBLIC_SITE_URL=http://localhost:4321

# Optional: Enable preview mode for draft content (true/false)
ENABLE_PREVIEW_MODE=false
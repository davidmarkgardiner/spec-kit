# Environment Variables Template for Yoga Studio Website
# Copy this file to .env and fill in your actual values
# NEVER commit the actual .env file with real credentials

# Sanity CMS Configuration
SANITY_PROJECT_ID=your_project_id_here
SANITY_DATASET=production
SANITY_TOKEN=your_sanity_token_here
SANITY_API_VERSION=2024-01-01

# Cloudinary Configuration (for image optimization)
PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Site Configuration
PUBLIC_SITE_URL=http://localhost:4321
PUBLIC_SITE_NAME=Yoga Studio

# Netlify Configuration (for deployment)
NETLIFY_SITE_ID=your_netlify_site_id
NETLIFY_AUTH_TOKEN=your_netlify_auth_token

# Environment
NODE_ENV=development
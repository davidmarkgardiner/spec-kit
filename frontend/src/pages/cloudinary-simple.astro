---
import { 
  getOptimizedImageUrl, 
  getResponsiveImageUrls, 
  getThumbnailUrl, 
  getPlaceholderUrl 
} from '../lib/cloudinary'

// Sample images from Cloudinary's demo collection
const sampleImages = [
  'sample',
  'woman',
  'cld-sample-5',
  'cld-sample-4',
  'cld-sample-3',
  'cld-sample-2'
]
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Cloudinary Integration Demo</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-gray-50">
    <div class="max-w-6xl mx-auto p-8">
      <h1 class="text-4xl font-bold text-center mb-8 text-gray-800">
        🌟 Cloudinary Integration Demo
      </h1>
      
      <!-- What is Cloudinary Section -->
      <div class="mb-8 bg-blue-50 p-6 rounded-lg">
        <h2 class="text-2xl font-semibold mb-4 text-blue-800">What is Cloudinary?</h2>
        <p class="text-gray-700 mb-4">
          Cloudinary is a comprehensive cloud-based image and video management solution that provides:
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <ul class="list-disc list-inside text-gray-600 space-y-2">
            <li><strong>Automatic Optimization:</strong> Smart compression and format selection</li>
            <li><strong>Dynamic Transformations:</strong> Resize, crop, rotate in real-time</li>
            <li><strong>Responsive Images:</strong> Multiple sizes for different devices</li>
          </ul>
          <ul class="list-disc list-inside text-gray-600 space-y-2">
            <li><strong>Advanced Effects:</strong> Blur, brightness, overlays, AI enhancements</li>
            <li><strong>Fast CDN Delivery:</strong> Global content delivery network</li>
            <li><strong>SEO Benefits:</strong> Faster page loads improve rankings</li>
          </ul>
        </div>
      </div>

      <!-- Basic Transformations -->
      <section class="mb-12">
        <h2 class="text-3xl font-semibold mb-6 text-gray-800">🎨 Basic Image Transformations</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          
          <!-- Original -->
          <div class="bg-white rounded-lg shadow-md overflow-hidden">
            <div class="aspect-video bg-gray-100 flex items-center justify-center">
              <img 
                src={getOptimizedImageUrl('sample')}
                alt="Original image"
                class="max-w-full max-h-full object-contain"
                loading="lazy"
              />
            </div>
            <div class="p-4">
              <h3 class="font-semibold text-lg mb-2">Original</h3>
              <p class="text-gray-600 text-sm">No transformations applied</p>
            </div>
          </div>

          <!-- Auto Optimized -->
          <div class="bg-white rounded-lg shadow-md overflow-hidden">
            <div class="aspect-video bg-gray-100 flex items-center justify-center">
              <img 
                src={getOptimizedImageUrl('sample', { width: 400, quality: 'auto', format: 'auto' })}
                alt="Auto optimized"
                class="max-w-full max-h-full object-contain"
                loading="lazy"
              />
            </div>
            <div class="p-4">
              <h3 class="font-semibold text-lg mb-2">Auto Optimized</h3>
              <p class="text-gray-600 text-sm">400px width, auto quality & format</p>
            </div>
          </div>

          <!-- Square Crop -->
          <div class="bg-white rounded-lg shadow-md overflow-hidden">
            <div class="aspect-video bg-gray-100 flex items-center justify-center">
              <img 
                src={getOptimizedImageUrl('sample', { width: 300, height: 300, crop: 'fill' })}
                alt="Square crop"
                class="max-w-full max-h-full object-contain"
                loading="lazy"
              />
            </div>
            <div class="p-4">
              <h3 class="font-semibold text-lg mb-2">Square Crop</h3>
              <p class="text-gray-600 text-sm">300x300 with fill crop</p>
            </div>
          </div>

          <!-- With Effects -->
          <div class="bg-white rounded-lg shadow-md overflow-hidden">
            <div class="aspect-video bg-gray-100 flex items-center justify-center">
              <img 
                src={getOptimizedImageUrl('sample', { 
                  width: 400, 
                  brightness: 20, 
                  contrast: 15,
                  saturation: 30 
                })}
                alt="Enhanced effects"
                class="max-w-full max-h-full object-contain"
                loading="lazy"
              />
            </div>
            <div class="p-4">
              <h3 class="font-semibold text-lg mb-2">Enhanced Colors</h3>
              <p class="text-gray-600 text-sm">Brightness +20, Contrast +15, Saturation +30</p>
            </div>
          </div>

          <!-- Blur Effect -->
          <div class="bg-white rounded-lg shadow-md overflow-hidden">
            <div class="aspect-video bg-gray-100 flex items-center justify-center">
              <img 
                src={getOptimizedImageUrl('sample', { width: 400, blur: 300 })}
                alt="Blur effect"
                class="max-w-full max-h-full object-contain"
                loading="lazy"
              />
            </div>
            <div class="p-4">
              <h3 class="font-semibold text-lg mb-2">Blur Effect</h3>
              <p class="text-gray-600 text-sm">Blur level 300 applied</p>
            </div>
          </div>

          <!-- Text Overlay -->
          <div class="bg-white rounded-lg shadow-md overflow-hidden">
            <div class="aspect-video bg-gray-100 flex items-center justify-center">
              <img 
                src={getOptimizedImageUrl('sample', { 
                  width: 400, 
                  overlay: { 
                    text: 'YOGA STUDIO', 
                    position: 'bottom-right' 
                  } 
                })}
                alt="Text overlay"
                class="max-w-full max-h-full object-contain"
                loading="lazy"
              />
            </div>
            <div class="p-4">
              <h3 class="font-semibold text-lg mb-2">Text Overlay</h3>
              <p class="text-gray-600 text-sm">Custom text positioned bottom-right</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Responsive Images Demo -->
      <section class="mb-12">
        <h2 class="text-3xl font-semibold mb-6 text-gray-800">📱 Responsive Images</h2>
        <div class="bg-white p-6 rounded-lg shadow-md">
          <p class="text-gray-700 mb-4">
            Cloudinary automatically generates optimized images for different screen sizes:
          </p>
          
          {(() => {
            const responsiveUrls = getResponsiveImageUrls('sample', { quality: 'auto' })
            return (
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 mb-6">
                {Object.entries(responsiveUrls).map(([breakpoint, url]) => (
                  <div class="text-center">
                    <div class="bg-gray-100 rounded-lg p-2 mb-2">
                      <img 
                        src={url} 
                        alt={`${breakpoint} version`}
                        class="w-full h-24 object-cover rounded"
                        loading="lazy"
                      />
                    </div>
                    <h4 class="font-medium capitalize">{breakpoint}</h4>
                    <p class="text-xs text-gray-500">
                      {breakpoint === 'mobile' && '640px'}
                      {breakpoint === 'tablet' && '768px'}
                      {breakpoint === 'desktop' && '1024px'}
                      {breakpoint === 'large' && '1920px'}
                      {breakpoint === 'xlarge' && '2560px'}
                    </p>
                  </div>
                ))}
              </div>
            )
          })()}
        </div>
      </section>

      <!-- Thumbnails Gallery -->
      <section class="mb-12">
        <h2 class="text-3xl font-semibold mb-6 text-gray-800">🖼️ Smart Thumbnails</h2>
        <div class="bg-white p-6 rounded-lg shadow-md">
          <p class="text-gray-700 mb-4">
            Generate consistent thumbnails with smart cropping:
          </p>
          
          <div class="flex flex-wrap gap-4 mb-6">
            {sampleImages.map((imageId) => (
              <div class="text-center">
                <div class="w-20 h-20 mb-2">
                  <img 
                    src={getThumbnailUrl(imageId, 80)}
                    alt={`Thumbnail of ${imageId}`}
                    class="w-full h-full object-cover rounded-lg shadow-sm hover:shadow-md transition-shadow"
                    loading="lazy"
                  />
                </div>
                <p class="text-xs text-gray-500">{imageId}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Placeholder Images -->
      <section class="mb-12">
        <h2 class="text-3xl font-semibold mb-6 text-gray-800">🎯 Placeholder Images</h2>
        <div class="bg-white p-6 rounded-lg shadow-md">
          <p class="text-gray-700 mb-4">
            Generate placeholder images for development and loading states:
          </p>
          
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
            <div class="text-center">
              <img 
                src={getPlaceholderUrl(300, 200, 'Hero Image')}
                alt="Hero placeholder"
                class="w-full rounded-lg shadow-sm mb-2"
                loading="lazy"
              />
              <p class="text-sm text-gray-600">Hero Image Placeholder (300x200)</p>
            </div>
            <div class="text-center">
              <img 
                src={getPlaceholderUrl(200, 200, 'Profile')}
                alt="Profile placeholder"
                class="w-full rounded-lg shadow-sm mb-2"
                loading="lazy"
              />
              <p class="text-sm text-gray-600">Profile Placeholder (200x200)</p>
            </div>
            <div class="text-center">
              <img 
                src={getPlaceholderUrl(300, 150, 'Gallery')}
                alt="Gallery placeholder"
                class="w-full rounded-lg shadow-sm mb-2"
                loading="lazy"
              />
              <p class="text-sm text-gray-600">Gallery Placeholder (300x150)</p>
            </div>
          </div>
        </div>
      </section>

      <!-- URL Examples -->
      <section class="mb-12">
        <h2 class="text-3xl font-semibold mb-6 text-gray-800">🔗 URL Examples</h2>
        <div class="bg-white p-6 rounded-lg shadow-md">
          <p class="text-gray-700 mb-4">
            See how Cloudinary transforms images through URL parameters:
          </p>
          
          <div class="space-y-4 text-sm">
            <div class="border-l-4 border-blue-500 pl-4">
              <p class="font-medium">Original Image:</p>
              <code class="block mt-1 p-2 bg-gray-100 rounded break-all text-xs">
                https://res.cloudinary.com/dgkk4uhse/image/upload/sample
              </code>
            </div>
            
            <div class="border-l-4 border-green-500 pl-4">
              <p class="font-medium">Auto-optimized (400px wide, auto quality & format):</p>
              <code class="block mt-1 p-2 bg-gray-100 rounded break-all text-xs">
                {getOptimizedImageUrl('sample', { width: 400, quality: 'auto', format: 'auto' })}
              </code>
            </div>
            
            <div class="border-l-4 border-purple-500 pl-4">
              <p class="font-medium">Square thumbnail with smart crop:</p>
              <code class="block mt-1 p-2 bg-gray-100 rounded break-all text-xs">
                {getThumbnailUrl('sample', 150)}
              </code>
            </div>
          </div>
        </div>
      </section>

      <!-- Performance Benefits -->
      <section class="mb-12">
        <h2 class="text-3xl font-semibold mb-6 text-gray-800">⚡ Performance Benefits</h2>
        <div class="bg-white p-6 rounded-lg shadow-md">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <h3 class="text-xl font-semibold mb-3 text-green-700">✅ With Cloudinary</h3>
              <ul class="space-y-2 text-sm text-gray-700">
                <li>• <strong>Automatic format selection:</strong> WebP for modern browsers, fallback to JPEG</li>
                <li>• <strong>Smart compression:</strong> 60-80% smaller file sizes without quality loss</li>
                <li>• <strong>Global CDN:</strong> Images served from nearest location</li>
                <li>• <strong>Lazy loading ready:</strong> Generate low-quality placeholders</li>
                <li>• <strong>Responsive by default:</strong> Perfect size for every device</li>
                <li>• <strong>SEO optimized:</strong> Faster page loads = better rankings</li>
              </ul>
            </div>
            <div>
              <h3 class="text-xl font-semibold mb-3 text-red-700">❌ Without Cloudinary</h3>
              <ul class="space-y-2 text-sm text-gray-700">
                <li>• Manual image optimization required</li>
                <li>• Large file sizes slow down page loads</li>
                <li>• Manual responsive image generation</li>
                <li>• No automatic format conversion</li>
                <li>• Server storage costs for multiple versions</li>
                <li>• Poor mobile performance</li>
              </ul>
            </div>
          </div>
        </div>
      </section>

      <!-- Usage Guide -->
      <section class="mb-8">
        <h2 class="text-3xl font-semibold mb-6 text-gray-800">🚀 How to Use in Your Project</h2>
        <div class="bg-white p-6 rounded-lg shadow-md">
          <div class="space-y-6">
            <div>
              <h3 class="text-lg font-semibold mb-3">1. Environment Setup</h3>
              <p class="text-gray-700 mb-2">Add your Cloudinary credentials to <code class="bg-gray-100 px-2 py-1 rounded">.env</code>:</p>
              <pre class="p-4 bg-gray-100 rounded overflow-x-auto text-sm">
PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
              </pre>
            </div>

            <div>
              <h3 class="text-lg font-semibold mb-3">2. Basic Usage</h3>
              <pre class="p-4 bg-gray-100 rounded overflow-x-auto text-sm">
{`import { getOptimizedImageUrl, getResponsiveImageUrls } from '../lib/cloudinary'

// Simple optimization
const optimizedUrl = getOptimizedImageUrl('my-image', {
  width: 800,
  quality: 'auto',
  format: 'auto'
})

// Responsive images
const responsiveUrls = getResponsiveImageUrls('my-image')
// Use responsiveUrls.mobile, responsiveUrls.desktop, etc.`}
              </pre>
            </div>

            <div>
              <h3 class="text-lg font-semibold mb-3">3. In Astro Components</h3>
              <pre class="p-4 bg-gray-100 rounded overflow-x-auto text-sm">
{`---
import { getOptimizedImageUrl } from '../lib/cloudinary'
const heroImage = getOptimizedImageUrl('hero-image', { 
  width: 1200, 
  height: 600, 
  crop: 'fill' 
})
---

<img src={heroImage} alt="Hero" class="w-full h-auto" />`}
              </pre>
            </div>
          </div>
        </div>
      </section>

      <!-- Footer -->
      <div class="text-center text-gray-500 mt-12">
        <p>Cloudinary Demo for Yoga Studio Website</p>
        <p class="text-sm">Visit the main demo at <a href="/cloudinary-demo" class="text-blue-600 hover:underline">/cloudinary-demo</a></p>
      </div>
    </div>
  </body>
</html>
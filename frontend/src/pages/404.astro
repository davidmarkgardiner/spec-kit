---
// 404 Error page - custom not found page
import Layout from '../layouts/Layout.astro'
import { getStudioInfo } from '../services/studioService'

// Fetch studio data for contact information
const studioData = await getStudioInfo({ preview: false })

// Page metadata
const pageTitle = 'Page Not Found - 404 Error'
const pageDescription = 'The page you are looking for could not be found. Navigate back to our homepage or use the links below to find what you need.'
---

<Layout 
  title={pageTitle}
  description={pageDescription}
  noindex={true}
>
  <main class="error-page bg-gradient-to-br from-slate-50 to-blue-50 min-h-screen">
    <div class="container mx-auto px-4 py-16 md:py-24">
      <div class="max-w-4xl mx-auto text-center">
        
        <!-- 404 Graphic -->
        <div class="mb-12">
          <div class="inline-block relative">
            <!-- Large 404 Text -->
            <div class="text-[12rem] md:text-[16rem] lg:text-[20rem] font-bold text-slate-200 leading-none select-none">
              404
            </div>
            
            <!-- Yoga Pose Silhouette Overlay -->
            <div class="absolute inset-0 flex items-center justify-center">
              <svg class="w-32 h-32 md:w-40 md:h-40 lg:w-48 lg:h-48 text-blue-600 opacity-80" viewBox="0 0 200 200" fill="currentColor">
                <!-- Simplified yoga pose silhouette -->
                <path d="M100 20C90 20 85 25 85 35C85 45 90 50 100 50C110 50 115 45 115 35C115 25 110 20 100 20Z"/>
                <path d="M100 55C95 55 90 58 88 62L75 85C70 90 70 95 75 100L85 110C88 113 92 115 95 115L105 115C108 115 112 113 115 110L125 100C130 95 130 90 125 85L112 62C110 58 105 55 100 55Z"/>
                <path d="M88 120L95 130C98 135 102 138 107 140L93 155C90 158 88 162 88 167L88 180C88 185 92 190 97 190C102 190 107 185 107 180L107 167C107 164 108 161 110 159L125 140C128 137 130 133 130 128C130 125 129 122 127 120L115 115L105 115C100 115 95 117 92 120L88 120Z"/>
                <path d="M112 120C115 117 120 115 125 115L135 115L147 120C149 122 150 125 150 128C150 133 148 137 145 140L160 159C162 161 163 164 163 167L163 180C163 185 158 190 153 190C148 190 143 185 143 180L143 167C143 162 141 158 138 155L124 140C129 138 132 135 135 130L142 120L112 120Z"/>
              </svg>
            </div>
          </div>
        </div>

        <!-- Error Message -->
        <div class="mb-12">
          <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-slate-900 mb-6">
            Oops! Page Not Found
          </h1>
          <p class="text-xl md:text-2xl text-slate-600 leading-relaxed mb-8">
            It looks like this page has found its way to a different pose. 
            Let's help you get back to your practice.
          </p>
          
          <!-- Helpful Message -->
          <div class="bg-white rounded-xl p-6 shadow-lg max-w-2xl mx-auto mb-8">
            <div class="flex items-start">
              <svg class="w-6 h-6 text-blue-600 mt-1 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <div class="text-left">
                <h3 class="font-semibold text-slate-900 mb-2">What might have happened?</h3>
                <ul class="text-slate-600 space-y-1 text-sm">
                  <li>• The page URL was typed incorrectly</li>
                  <li>• The page may have been moved or deleted</li>
                  <li>• The link you followed might be outdated</li>
                  <li>• You may need to log in to access this content</li>
                </ul>
              </div>
            </div>
          </div>
        </div>

        <!-- Navigation Options -->
        <div class="mb-16">
          <h2 class="text-2xl font-bold text-slate-900 mb-8">
            Find Your Way Back
          </h2>
          
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 max-w-4xl mx-auto">
            <!-- Home -->
            <a 
              href="/"
              class="nav-card bg-white rounded-xl p-6 shadow-lg hover:shadow-xl transition-all duration-200 transform hover:scale-105 group"
            >
              <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4 group-hover:bg-blue-200 transition-colors">
                <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
                </svg>
              </div>
              <h3 class="font-semibold text-slate-900 mb-2">Home</h3>
              <p class="text-sm text-slate-600">Return to our homepage and start fresh</p>
            </a>

            <!-- Classes & Membership -->
            <a 
              href="/membership"
              class="nav-card bg-white rounded-xl p-6 shadow-lg hover:shadow-xl transition-all duration-200 transform hover:scale-105 group"
            >
              <div class="w-12 h-12 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4 group-hover:bg-green-200 transition-colors">
                <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path>
                </svg>
              </div>
              <h3 class="font-semibold text-slate-900 mb-2">Membership</h3>
              <p class="text-sm text-slate-600">View our classes and pricing plans</p>
            </a>

            <!-- About -->
            <a 
              href="/about"
              class="nav-card bg-white rounded-xl p-6 shadow-lg hover:shadow-xl transition-all duration-200 transform hover:scale-105 group"
            >
              <div class="w-12 h-12 bg-purple-100 rounded-full flex items-center justify-center mx-auto mb-4 group-hover:bg-purple-200 transition-colors">
                <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <h3 class="font-semibold text-slate-900 mb-2">About Us</h3>
              <p class="text-sm text-slate-600">Learn about our studio and philosophy</p>
            </a>

            <!-- Instructors -->
            <a 
              href="/instructors"
              class="nav-card bg-white rounded-xl p-6 shadow-lg hover:shadow-xl transition-all duration-200 transform hover:scale-105 group"
            >
              <div class="w-12 h-12 bg-orange-100 rounded-full flex items-center justify-center mx-auto mb-4 group-hover:bg-orange-200 transition-colors">
                <svg class="w-6 h-6 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                </svg>
              </div>
              <h3 class="font-semibold text-slate-900 mb-2">Instructors</h3>
              <p class="text-sm text-slate-600">Meet our experienced teaching team</p>
            </a>

            <!-- Gallery -->
            <a 
              href="/gallery"
              class="nav-card bg-white rounded-xl p-6 shadow-lg hover:shadow-xl transition-all duration-200 transform hover:scale-105 group"
            >
              <div class="w-12 h-12 bg-pink-100 rounded-full flex items-center justify-center mx-auto mb-4 group-hover:bg-pink-200 transition-colors">
                <svg class="w-6 h-6 text-pink-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
              </div>
              <h3 class="font-semibold text-slate-900 mb-2">Gallery</h3>
              <p class="text-sm text-slate-600">Browse our studio and class photos</p>
            </a>

            <!-- Contact -->
            <a 
              href="/contact"
              class="nav-card bg-white rounded-xl p-6 shadow-lg hover:shadow-xl transition-all duration-200 transform hover:scale-105 group"
            >
              <div class="w-12 h-12 bg-teal-100 rounded-full flex items-center justify-center mx-auto mb-4 group-hover:bg-teal-200 transition-colors">
                <svg class="w-6 h-6 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                </svg>
              </div>
              <h3 class="font-semibold text-slate-900 mb-2">Contact</h3>
              <p class="text-sm text-slate-600">Get in touch with questions</p>
            </a>
          </div>
        </div>

        <!-- Search or Direct Contact -->
        <div class="grid lg:grid-cols-2 gap-8 max-w-4xl mx-auto mb-16">
          <!-- Search Suggestions -->
          <div class="bg-white rounded-xl p-8 shadow-lg text-left">
            <h3 class="text-xl font-bold text-slate-900 mb-4 flex items-center">
              <svg class="w-6 h-6 text-blue-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
              </svg>
              Looking for Something Specific?
            </h3>
            <div class="space-y-3 text-slate-600">
              <div class="flex items-start">
                <span class="text-blue-600 mr-2 font-bold">•</span>
                <span><strong>Class schedules:</strong> Visit our membership page</span>
              </div>
              <div class="flex items-start">
                <span class="text-blue-600 mr-2 font-bold">•</span>
                <span><strong>Studio location:</strong> Check our contact page</span>
              </div>
              <div class="flex items-start">
                <span class="text-blue-600 mr-2 font-bold">•</span>
                <span><strong>Teacher info:</strong> Browse our instructors page</span>
              </div>
              <div class="flex items-start">
                <span class="text-blue-600 mr-2 font-bold">•</span>
                <span><strong>Studio photos:</strong> Explore our gallery</span>
              </div>
            </div>
          </div>

          <!-- Direct Contact -->
          <div class="bg-white rounded-xl p-8 shadow-lg text-left">
            <h3 class="text-xl font-bold text-slate-900 mb-4 flex items-center">
              <svg class="w-6 h-6 text-green-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              Still Need Help?
            </h3>
            <div class="space-y-4">
              <p class="text-slate-600">
                Can't find what you're looking for? We're here to help!
              </p>
              
              <div class="flex flex-col space-y-3">
                {studioData?.phone && (
                  <a 
                    href={`tel:${studioData.phone}`}
                    class="flex items-center text-blue-600 hover:text-blue-700 font-medium"
                  >
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                    </svg>
                    {studioData.phone}
                  </a>
                )}
                
                {studioData?.email && (
                  <a 
                    href={`mailto:${studioData.email}`}
                    class="flex items-center text-blue-600 hover:text-blue-700 font-medium"
                  >
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                    </svg>
                    {studioData.email}
                  </a>
                )}
              </div>
            </div>
          </div>
        </div>

        <!-- Primary CTA -->
        <div class="text-center">
          <a 
            href="/"
            class="inline-flex items-center px-8 py-4 bg-blue-600 text-white font-semibold rounded-full hover:bg-blue-700 transition-colors duration-200 text-lg"
          >
            <svg class="w-6 h-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
            </svg>
            Return to Homepage
          </a>
          
          <div class="mt-4 text-slate-500">
            <p class="text-sm">
              Or use your browser's back button to return to the previous page
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Inspirational Quote Footer -->
    <div class="bg-white border-t border-slate-200">
      <div class="container mx-auto px-4 py-8 text-center">
        <blockquote class="text-lg text-slate-600 italic mb-4 max-w-2xl mx-auto">
          "In yoga, as in life, sometimes we need to find our way back to center. 
          Every step, even the wrong ones, are part of the journey."
        </blockquote>
        <cite class="text-slate-500 font-medium">
          — Yoga Wisdom
        </cite>
      </div>
    </div>
  </main>

  <!-- Structured Data for SEO -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "404 Error - Page Not Found",
    "description": "{pageDescription}",
    "url": "{Astro.url.href}",
    "mainEntity": {
      "@type": "WebSite",
      "name": "{studioData?.name || 'Yoga Studio'}",
      "url": "{Astro.site}",
      "potentialAction": {
        "@type": "SearchAction",
        "target": "{Astro.site}/?search={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    }
  }
  </script>
</Layout>

<style>
  .error-page {
    @apply relative;
  }

  /* Animated gradient background */
  .error-page::before {
    content: '';
    @apply absolute inset-0 opacity-30;
    background: linear-gradient(-45deg, #f1f5f9, #e0f2fe, #f0f9ff, #f8fafc);
    background-size: 400% 400%;
    animation: gradientShift 15s ease infinite;
  }

  @keyframes gradientShift {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }

  /* Navigation cards hover effects */
  .nav-card {
    @apply relative overflow-hidden;
  }

  .nav-card::before {
    content: '';
    @apply absolute inset-0 bg-gradient-to-r from-blue-50 to-purple-50 opacity-0 transition-opacity duration-200;
  }

  .nav-card:hover::before {
    @apply opacity-100;
  }

  .nav-card > * {
    @apply relative z-10;
  }

  /* 404 number styling */
  .error-page h1 {
    @apply relative;
  }

  .error-page h1::after {
    content: '';
    @apply absolute bottom-0 left-1/2 transform -translate-x-1/2 w-24 h-1 bg-blue-600 rounded-full;
  }

  /* Responsive design */
  @media (max-width: 768px) {
    .nav-card {
      @apply p-4;
    }

    .error-page .text-\[12rem\] {
      @apply text-[8rem];
    }
  }

  /* Print styles */
  @media print {
    .error-page {
      @apply text-black bg-white;
    }
    
    .error-page::before {
      @apply hidden;
    }

    .nav-card {
      @apply shadow-none border border-slate-200;
    }
  }

  /* Accessibility */
  .nav-card:focus {
    @apply ring-4 ring-blue-200 outline-none;
  }

  /* High contrast mode support */
  @media (prefers-contrast: high) {
    .error-page {
      @apply text-black bg-white;
    }
    
    .nav-card {
      @apply border border-black;
    }
  }

  /* Reduced motion support */
  @media (prefers-reduced-motion: reduce) {
    .error-page::before,
    .nav-card,
    * {
      @apply transition-none;
      animation: none !important;
    }
  }

  /* Focus indicators for keyboard navigation */
  .nav-card:focus-visible {
    @apply ring-4 ring-blue-200 ring-offset-2;
  }

  a:focus-visible {
    @apply ring-4 ring-blue-200 ring-offset-2 rounded;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Track 404 page visits for analytics (if analytics are implemented)
    if (typeof gtag !== 'undefined') {
      gtag('event', '404_error', {
        'page_location': window.location.href,
        'page_referrer': document.referrer
      })
    }

    // Add subtle animations on card hover
    const navCards = document.querySelectorAll('.nav-card')
    navCards.forEach(card => {
      card.addEventListener('mouseenter', () => {
        card.style.transform = 'translateY(-4px) scale(1.02)'
      })
      
      card.addEventListener('mouseleave', () => {
        card.style.transform = ''
      })
    })

    // Keyboard navigation enhancement
    document.addEventListener('keydown', (e) => {
      // ESC key returns to homepage
      if (e.key === 'Escape') {
        window.location.href = '/'
      }
      
      // Allow quick navigation with number keys
      const keyMap = {
        '1': '/',
        '2': '/membership',
        '3': '/about', 
        '4': '/instructors',
        '5': '/gallery',
        '6': '/contact'
      }
      
      if (keyMap[e.key] && !e.ctrlKey && !e.altKey && !e.metaKey) {
        window.location.href = keyMap[e.key]
      }
    })

    // Add a fun Easter egg for persistent users
    let clickCount = 0
    const yogaPose = document.querySelector('.absolute svg')
    
    if (yogaPose) {
      yogaPose.addEventListener('click', () => {
        clickCount++
        
        if (clickCount === 1) {
          yogaPose.style.transform = 'rotate(180deg) scale(1.1)'
          yogaPose.style.transition = 'transform 0.5s ease'
        } else if (clickCount === 3) {
          yogaPose.style.transform = 'rotate(360deg) scale(1.2)'
          setTimeout(() => {
            yogaPose.style.transform = ''
            clickCount = 0
          }, 1000)
        }
      })
    }

    // Preload key pages for better UX
    const importantPages = ['/', '/membership', '/contact']
    importantPages.forEach(page => {
      const link = document.createElement('link')
      link.rel = 'prefetch'
      link.href = page
      document.head.appendChild(link)
    })
  })
</script>
---
// PhotoGallery component - displays studio photos with filtering and lightbox
// This component implements the contract from PhotoGallery.test.ts
export interface Props {
  photos: Array<{
    title: string
    image: {
      _type: 'image'
      asset: {
        _ref: string
        _type: 'reference'
      }
      hotspot?: { x: number; y: number }
      crop?: { left: number; top: number; right: number; bottom: number }
    }
    altText?: string
    category: 'studio-space' | 'equipment' | 'classes-in-session' | 'exterior'
    featured?: boolean
    sortOrder?: number
    photographer?: string
    dateTaken?: string
    caption?: string
  }>
  className?: string
  layout?: 'grid' | 'masonry' | 'carousel'
  theme?: 'light' | 'dark'
  columns?: number
  groupByCategory?: boolean
  showFilters?: boolean
  showMetadata?: boolean
  highlightFeatured?: boolean
  enableLightbox?: boolean
  enablePagination?: boolean
  itemsPerPage?: number
  sortBy?: 'sortOrder' | 'dateTaken' | 'title'
  sortOrder?: 'asc' | 'desc'
  enableSharing?: boolean
  loading?: boolean
}

const { 
  photos = [],
  className = '', 
  layout = 'grid',
  theme = 'light',
  columns = 3,
  groupByCategory = false,
  showFilters = false,
  showMetadata = false,
  highlightFeatured = false,
  enableLightbox = true,
  enablePagination = false,
  itemsPerPage = 12,
  sortBy = 'sortOrder',
  sortOrder = 'asc',
  enableSharing = false,
  loading = false
} = Astro.props

// Sort photos
const sortedPhotos = [...photos].sort((a, b) => {
  let aValue: any = a[sortBy as keyof typeof a] || 0
  let bValue: any = b[sortBy as keyof typeof b] || 0
  
  if (typeof aValue === 'string') {
    aValue = aValue.toLowerCase()
    bValue = bValue.toLowerCase()
  }
  
  if (sortOrder === 'desc') {
    return aValue < bValue ? 1 : aValue > bValue ? -1 : 0
  }
  return aValue > bValue ? 1 : aValue < bValue ? -1 : 0
})

// Import Sanity image URL builder
import { urlFor } from '../lib/sanity'

// Generate image URL with Sanity CDN optimization
const getImageUrl = (image: any, size: 'thumb' | 'medium' | 'large' = 'medium') => {
  if (!image?.asset) return '/placeholder-photo.jpg'
  
  // Handle direct URLs (for mock data or external images)
  if (image.asset.url && !image.asset._ref) {
    return image.asset.url
  }
  
  const sizeMap = {
    thumb: { width: 400, height: 300 },
    medium: { width: 800, height: 600 }, 
    large: { width: 1600, height: 1200 }
  }
  
  const { width, height } = sizeMap[size]
  
  try {
    return urlFor(image)
      .width(width)
      .height(height)
      .fit('crop')
      .auto('format')
      .quality(80)
      .url()
  } catch (error) {
    console.error('Error generating image URL:', error)
    return '/placeholder-photo.jpg'
  }
}

// Get category display name
const getCategoryName = (category: string) => {
  const categoryMap: { [key: string]: string } = {
    'studio-space': 'Studio Space',
    'equipment': 'Equipment',
    'classes-in-session': 'Classes in Session',
    'exterior': 'Exterior'
  }
  return categoryMap[category] || category
}

// Get unique categories
const categories = Array.from(new Set(photos.map(photo => photo.category)))

// Format date
const formatDate = (dateString: string) => {
  if (!dateString) return ''
  return new Date(dateString).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  })
}

// Group photos by category if requested
const groupedPhotos = groupByCategory 
  ? categories.reduce((acc, category) => {
      acc[category] = sortedPhotos.filter(photo => photo.category === category)
      return acc
    }, {} as Record<string, typeof sortedPhotos>)
  : { all: sortedPhotos }
---

{loading ? (
  <div 
    data-testid="photo-gallery"
    class={`photo-gallery loading skeleton ${layout} ${className} ${theme} responsive mobile`}
    role="region"
    aria-label="Photo gallery loading"
  >
    <div class="gallery-loading">
      {Array.from({ length: 6 }).map((_, i) => (
        <div key={i} data-testid="photo-placeholder" class="photo-placeholder">
          <div class="placeholder-image"></div>
          {showMetadata && (
            <div class="placeholder-metadata">
              <div class="placeholder-title"></div>
              <div class="placeholder-info"></div>
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
) : photos.length === 0 ? (
  <div 
    data-testid="empty-gallery"
    class={`empty-gallery ${className} ${theme}`}
    role="region"
    aria-label="No photos available"
  >
    <div class="empty-content">
      <div class="empty-icon">📸</div>
      <h3 class="empty-title">No Photos Yet</h3>
      <p class="empty-message">Our photo gallery is coming soon. Check back for beautiful images of our studio space and classes.</p>
    </div>
  </div>
) : (
  <div 
    data-testid="photo-gallery"
    class={`photo-gallery ${layout} ${className} ${theme} col-${columns} columns-${columns} responsive mobile`}
    role="region"
    aria-label="Studio photo gallery"
  >
    {showFilters && (
      <div class="gallery-filters" role="toolbar" aria-label="Photo category filters">
        <button 
          data-testid="filter-all"
          class="filter-button active"
          data-filter="all"
          aria-pressed="true"
        >
          Show All
        </button>
        {categories.map(category => (
          <button 
            key={category}
            data-testid={`filter-${category}`}
            class="filter-button"
            data-filter={category}
            aria-pressed="false"
          >
            {getCategoryName(category)}
          </button>
        ))}
      </div>
    )}

    {Object.entries(groupedPhotos).map(([categoryKey, categoryPhotos]) => (
      <div 
        key={categoryKey}
        data-testid={categoryKey !== 'all' ? `category-${categoryKey}` : undefined}
        class={`gallery-section ${categoryKey !== 'all' ? 'category-section' : ''}`}
      >
        {groupByCategory && categoryKey !== 'all' && (
          <h3 class="category-title">{getCategoryName(categoryKey)}</h3>
        )}
        
        <div class={`gallery-grid ${layout}`}>
          {categoryPhotos.slice(0, enablePagination ? itemsPerPage : categoryPhotos.length).map((photo, index) => (
            <article 
              key={index}
              data-testid="photo-item"
              class={`photo-item ${photo.featured && highlightFeatured ? 'featured highlight' : ''} responsive fluid`}
              role="img"
              aria-label={`${photo.title}${photo.photographer ? ` by ${photo.photographer}` : ''}`}
              data-category={photo.category}
            >
              <div class="photo-container">
                <img 
                  src={getImageUrl(photo.image, 'medium')}
                  alt={photo.altText || photo.title}
                  width="800"
                  height="600"
                  loading="lazy"
                  class="photo-image"
                  data-large-src={getImageUrl(photo.image, 'large')}
                  onerror="this.src='/placeholder-photo.jpg'; this.onerror=null;"
                />
                
                {photo.featured && highlightFeatured && (
                  <div data-testid="featured-badge" class="featured-badge">
                    ⭐ Featured
                  </div>
                )}

                {enableLightbox && (
                  <button 
                    class="photo-overlay"
                    aria-label={`View ${photo.title} in full size`}
                    data-photo-index={index}
                  >
                    <span class="overlay-icon">🔍</span>
                    <span class="overlay-text">View Full Size</span>
                  </button>
                )}

                {enableSharing && (
                  <button 
                    data-testid="share-photo"
                    class="share-button"
                    aria-label={`Share ${photo.title}`}
                    data-share-title={photo.title}
                    data-share-url={getImageUrl(photo.image, 'large')}
                  >
                    📤
                  </button>
                )}
                
                <div data-testid="image-error" class="image-error" style="display: none;">
                  <div data-testid="image-placeholder" class="error-placeholder">
                    <div class="error-icon">📷</div>
                    <p class="error-text">Image unavailable</p>
                  </div>
                </div>
              </div>

              {showMetadata && (
                <div class="photo-metadata">
                  <h4 data-testid="photo-title" class="photo-title">
                    {photo.title}
                  </h4>
                  
                  {photo.photographer && (
                    <p data-testid="photo-photographer" class="photo-photographer">
                      Photo by {photo.photographer}
                    </p>
                  )}
                  
                  {photo.dateTaken && (
                    <p data-testid="photo-date" class="photo-date">
                      {formatDate(photo.dateTaken)}
                    </p>
                  )}
                  
                  {photo.caption && (
                    <p class="photo-caption">{photo.caption}</p>
                  )}
                </div>
              )}
            </article>
          ))}
        </div>

        {enablePagination && categoryPhotos.length > itemsPerPage && (
          <div class="gallery-pagination">
            <button 
              data-testid="load-more"
              class="load-more-button"
              data-category={categoryKey}
            >
              Load More Photos
            </button>
            
            <div data-testid="pagination" class="pagination-info">
              Showing {Math.min(itemsPerPage, categoryPhotos.length)} of {categoryPhotos.length} photos
            </div>
          </div>
        )}
      </div>
    ))}
  </div>
)}

<!-- Lightbox Modal -->
{enableLightbox && !loading && photos.length > 0 && (
  <div 
    data-testid="photo-lightbox"
    class="photo-lightbox"
    style="display: none;"
    role="dialog"
    aria-modal="true"
    aria-labelledby="lightbox-title"
  >
    <div class="lightbox-backdrop"></div>
    <div class="lightbox-content">
      <button 
        data-testid="close-lightbox"
        class="lightbox-close"
        aria-label="Close photo viewer"
      >
        ✕
      </button>
      
      <button 
        data-testid="prev-photo"
        class="lightbox-nav lightbox-prev"
        aria-label="Previous photo"
      >
        ◀
      </button>
      
      <div class="lightbox-image-container">
        <img 
          class="lightbox-image"
          alt=""
          id="lightbox-image"
        />
        <div class="lightbox-info">
          <h3 id="lightbox-title" class="lightbox-title"></h3>
          <p class="lightbox-photographer"></p>
        </div>
      </div>
      
      <button 
        data-testid="next-photo"
        class="lightbox-nav lightbox-next"
        aria-label="Next photo"
      >
        ▶
      </button>
    </div>
  </div>
)}

<style>
.photo-gallery {
  width: 100%;
  max-width: 1200px;
  margin: 0 auto;
}

/* Empty state */
.empty-gallery {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 400px;
  background: #f9fafb;
  border-radius: 1rem;
  border: 2px dashed #d1d5db;
}

.empty-content {
  text-align: center;
  padding: 2rem;
}

.empty-icon {
  font-size: 4rem;
  margin-bottom: 1rem;
  opacity: 0.5;
}

.empty-title {
  font-size: 1.5rem;
  font-weight: 600;
  color: #6b7280;
  margin: 0 0 0.5rem 0;
}

.empty-message {
  font-size: 1rem;
  color: #9ca3af;
  margin: 0;
  max-width: 400px;
}

/* Filters */
.gallery-filters {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
  margin-bottom: 2rem;
  padding-bottom: 1rem;
  border-bottom: 2px solid #f3f4f6;
}

.filter-button {
  padding: 0.5rem 1rem;
  background: white;
  border: 2px solid #e5e7eb;
  border-radius: 2rem;
  color: #6b7280;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.2s ease;
  min-height: 44px;
}

.filter-button:hover {
  border-color: #22c55e;
  background: #f0fdf4;
  color: #166534;
}

.filter-button.active {
  background: #22c55e;
  border-color: #16a34a;
  color: white;
}

.filter-button:focus {
  outline: 2px solid #22c55e;
  outline-offset: 2px;
}

/* Category sections */
.category-section {
  margin-bottom: 3rem;
}

.category-title {
  font-size: 1.5rem;
  font-weight: 700;
  color: #1f2937;
  margin: 0 0 1.5rem 0;
  padding-bottom: 0.5rem;
  border-bottom: 2px solid #22c55e;
}

/* Gallery grid */
.gallery-grid {
  display: grid;
  gap: 1.5rem;
}

.gallery-grid.grid {
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
}

.gallery-grid.masonry {
  columns: 3;
  column-gap: 1.5rem;
}

.gallery-grid.carousel {
  display: flex;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  padding-bottom: 1rem;
}

/* Photo items */
.photo-item {
  background: white;
  border-radius: 1rem;
  overflow: hidden;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
  break-inside: avoid;
  margin-bottom: 1.5rem;
}

.photo-item:hover {
  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
  transform: translateY(-2px);
}

.photo-item.featured {
  border: 3px solid #22c55e;
  box-shadow: 0 8px 25px rgba(34, 197, 94, 0.2);
}

.photo-item.featured::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4px;
  background: linear-gradient(90deg, #22c55e, #16a34a);
  z-index: 1;
}

/* Photo container */
.photo-container {
  position: relative;
  overflow: hidden;
}

.photo-image {
  width: 100%;
  height: auto;
  object-fit: cover;
  transition: transform 0.3s ease;
}

.photo-item:hover .photo-image {
  transform: scale(1.05);
}

.featured-badge {
  position: absolute;
  top: 0.75rem;
  left: 0.75rem;
  background: linear-gradient(135deg, #22c55e, #16a34a);
  color: white;
  padding: 0.375rem 0.75rem;
  border-radius: 1rem;
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.025em;
  z-index: 2;
}

.photo-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.3s ease;
  border: none;
  cursor: pointer;
  color: white;
}

.photo-item:hover .photo-overlay {
  opacity: 1;
}

.overlay-icon {
  font-size: 2rem;
  margin-bottom: 0.5rem;
}

.overlay-text {
  font-size: 0.875rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.025em;
}

.share-button {
  position: absolute;
  top: 0.75rem;
  right: 0.75rem;
  background: rgba(0, 0, 0, 0.7);
  color: white;
  border: none;
  border-radius: 50%;
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.2s ease;
  z-index: 2;
}

.share-button:hover {
  background: #22c55e;
  transform: scale(1.1);
}

/* Image error handling */
.image-error {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: #f9fafb;
  display: flex;
  align-items: center;
  justify-content: center;
}

.error-placeholder {
  text-align: center;
  color: #6b7280;
}

.error-icon {
  font-size: 2rem;
  margin-bottom: 0.5rem;
  opacity: 0.5;
}

.error-text {
  font-size: 0.875rem;
  margin: 0;
}

/* Photo metadata */
.photo-metadata {
  padding: 1.5rem;
}

.photo-title {
  font-size: 1.125rem;
  font-weight: 600;
  color: #1f2937;
  margin: 0 0 0.75rem 0;
  line-height: 1.4;
}

.photo-photographer {
  font-size: 0.875rem;
  color: #6b7280;
  margin: 0 0 0.5rem 0;
  font-style: italic;
}

.photo-date {
  font-size: 0.875rem;
  color: #9ca3af;
  margin: 0 0 0.75rem 0;
}

.photo-caption {
  font-size: 0.9375rem;
  color: #4b5563;
  margin: 0;
  line-height: 1.5;
}

/* Pagination */
.gallery-pagination {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1rem;
  margin-top: 2rem;
  padding-top: 2rem;
  border-top: 2px solid #f3f4f6;
}

.load-more-button {
  background: linear-gradient(135deg, #22c55e, #16a34a);
  color: white;
  border: none;
  border-radius: 0.75rem;
  padding: 0.875rem 2rem;
  font-size: 1rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
  min-height: 44px;
}

.load-more-button:hover {
  background: linear-gradient(135deg, #16a34a, #15803d);
  transform: translateY(-1px);
  box-shadow: 0 4px 15px rgba(34, 197, 94, 0.3);
}

.pagination-info {
  font-size: 0.875rem;
  color: #6b7280;
  text-align: center;
}

/* Loading states */
.gallery-loading {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 1.5rem;
}

.photo-placeholder {
  background: white;
  border-radius: 1rem;
  overflow: hidden;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
}

.placeholder-image {
  width: 100%;
  height: 200px;
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: shimmer 2s infinite;
}

.placeholder-metadata {
  padding: 1.5rem;
}

.placeholder-title {
  height: 1.25rem;
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: shimmer 2s infinite;
  border-radius: 0.25rem;
  margin-bottom: 0.75rem;
}

.placeholder-info {
  height: 1rem;
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: shimmer 2s infinite;
  border-radius: 0.25rem;
  width: 60%;
}

@keyframes shimmer {
  0% { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}

/* Lightbox */
.photo-lightbox {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 2rem;
}

.lightbox-backdrop {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.9);
  cursor: pointer;
}

.lightbox-content {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  max-width: 100%;
  max-height: 100%;
  z-index: 1001;
}

.lightbox-close {
  position: absolute;
  top: -3rem;
  right: 0;
  background: none;
  border: none;
  color: white;
  font-size: 2rem;
  cursor: pointer;
  z-index: 1002;
  padding: 0.5rem;
  line-height: 1;
}

.lightbox-nav {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  background: rgba(255, 255, 255, 0.2);
  border: none;
  color: white;
  font-size: 2rem;
  cursor: pointer;
  padding: 1rem;
  border-radius: 0.5rem;
  transition: all 0.2s ease;
  z-index: 1002;
}

.lightbox-nav:hover {
  background: rgba(255, 255, 255, 0.3);
  transform: translateY(-50%) scale(1.1);
}

.lightbox-prev {
  left: -4rem;
}

.lightbox-next {
  right: -4rem;
}

.lightbox-image-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  max-width: 100%;
  max-height: 100%;
}

.lightbox-image {
  max-width: 100%;
  max-height: 80vh;
  object-fit: contain;
  border-radius: 0.5rem;
}

.lightbox-info {
  background: rgba(0, 0, 0, 0.8);
  color: white;
  padding: 1rem 2rem;
  text-align: center;
  border-radius: 0 0 0.5rem 0.5rem;
  max-width: 100%;
}

.lightbox-title {
  font-size: 1.25rem;
  font-weight: 600;
  margin: 0 0 0.5rem 0;
}

.lightbox-photographer {
  font-size: 0.875rem;
  color: #d1d5db;
  margin: 0;
  font-style: italic;
}

/* Theme variations */
.photo-gallery.dark {
  color: white;
}

.photo-gallery.dark .photo-item {
  background: #374151;
}

.photo-gallery.dark .photo-title {
  color: white;
}

.photo-gallery.dark .category-title {
  color: white;
}

.photo-gallery.dark .empty-gallery {
  background: #374151;
  border-color: #4b5563;
}

/* Responsive design */
@media (min-width: 768px) {
  .gallery-grid.masonry {
    columns: 3;
  }
  
  .photo-gallery.col-2 .gallery-grid.grid {
    grid-template-columns: repeat(2, 1fr);
  }
  
  .photo-gallery.col-3 .gallery-grid.grid {
    grid-template-columns: repeat(3, 1fr);
  }
  
  .photo-gallery.col-4 .gallery-grid.grid {
    grid-template-columns: repeat(4, 1fr);
  }
}

@media (min-width: 1024px) {
  .gallery-grid {
    gap: 2rem;
  }
  
  .photo-item {
    margin-bottom: 2rem;
  }
}

/* Mobile optimizations */
@media (max-width: 768px) {
  .photo-gallery {
    padding: 0 1rem;
  }
  
  .gallery-grid.masonry {
    columns: 2;
  }
  
  .gallery-grid.grid {
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1rem;
  }
  
  .gallery-filters {
    justify-content: center;
  }
  
  .filter-button {
    font-size: 0.875rem;
    padding: 0.375rem 0.75rem;
  }
  
  .lightbox-nav {
    display: none;
  }
  
  .lightbox-close {
    top: -2rem;
    font-size: 1.5rem;
  }
  
  .lightbox-info {
    padding: 0.75rem 1rem;
  }
}

@media (max-width: 480px) {
  .gallery-grid.masonry {
    columns: 1;
  }
  
  .gallery-grid.grid {
    grid-template-columns: 1fr;
  }
  
  .photo-item {
    margin-bottom: 1rem;
  }
  
  .photo-metadata {
    padding: 1rem;
  }
}

/* Print styles */
@media print {
  .photo-lightbox,
  .filter-button,
  .photo-overlay,
  .share-button {
    display: none !important;
  }
  
  .photo-gallery {
    break-inside: avoid;
  }
}

/* High contrast mode */
@media (prefers-contrast: high) {
  .filter-button {
    border-color: #000;
  }
  
  .filter-button.active {
    background: #000;
    border-color: #000;
  }
  
  .photo-item {
    border: 1px solid #000;
  }
}

/* Reduced motion */
@media (prefers-reduced-motion: reduce) {
  .photo-item,
  .photo-image,
  .filter-button,
  .lightbox-nav {
    transition: none;
  }
  
  .photo-item:hover {
    transform: none;
  }
  
  .photo-item:hover .photo-image {
    transform: none;
  }
  
  .shimmer {
    animation: none;
  }
}

/* Focus visible */
.filter-button:focus-visible,
.photo-overlay:focus-visible,
.lightbox-close:focus-visible,
.lightbox-nav:focus-visible {
  outline: 3px solid #22c55e;
  outline-offset: 2px;
}
</style>

<script>
// Photo gallery functionality
document.addEventListener('DOMContentLoaded', () => {
  const galleries = document.querySelectorAll('[data-testid="photo-gallery"]');
  
  galleries.forEach(gallery => {
    // Filter functionality
    const filterButtons = gallery.querySelectorAll('.filter-button');
    const photoItems = gallery.querySelectorAll('.photo-item');
    
    filterButtons.forEach(button => {
      button.addEventListener('click', () => {
        const filter = button.dataset.filter;
        
        // Update active filter
        filterButtons.forEach(btn => {
          btn.classList.remove('active');
          btn.setAttribute('aria-pressed', 'false');
        });
        button.classList.add('active');
        button.setAttribute('aria-pressed', 'true');
        
        // Filter photos
        photoItems.forEach(item => {
          const category = item.dataset.category;
          const shouldShow = filter === 'all' || category === filter;
          
          item.style.display = shouldShow ? 'block' : 'none';
          item.hidden = !shouldShow;
        });
      });
    });
    
    // Lightbox functionality
    const lightbox = document.querySelector('[data-testid="photo-lightbox"]');
    const overlays = gallery.querySelectorAll('.photo-overlay');
    
    if (lightbox && overlays.length > 0) {
      let currentPhotoIndex = 0;
      const photos = Array.from(gallery.querySelectorAll('.photo-item'));
      
      const openLightbox = (index) => {
        currentPhotoIndex = index;
        updateLightboxImage();
        lightbox.style.display = 'flex';
        document.body.style.overflow = 'hidden';
        lightbox.focus();
      };
      
      const closeLightbox = () => {
        lightbox.style.display = 'none';
        document.body.style.overflow = '';
      };
      
      const updateLightboxImage = () => {
        const photo = photos[currentPhotoIndex];
        if (!photo) return;
        
        const img = photo.querySelector('.photo-image');
        const lightboxImg = lightbox.querySelector('.lightbox-image');
        const lightboxTitle = lightbox.querySelector('.lightbox-title');
        const lightboxPhotographer = lightbox.querySelector('.lightbox-photographer');
        
        if (img && lightboxImg) {
          lightboxImg.src = img.dataset.largeSrc || img.src;
          lightboxImg.alt = img.alt;
          
          const titleEl = photo.querySelector('[data-testid="photo-title"]');
          const photographerEl = photo.querySelector('[data-testid="photo-photographer"]');
          
          if (lightboxTitle) {
            lightboxTitle.textContent = titleEl ? titleEl.textContent : img.alt;
          }
          
          if (lightboxPhotographer) {
            lightboxPhotographer.textContent = photographerEl ? photographerEl.textContent : '';
            lightboxPhotographer.style.display = photographerEl ? 'block' : 'none';
          }
        }
      };
      
      const nextPhoto = () => {
        currentPhotoIndex = (currentPhotoIndex + 1) % photos.length;
        updateLightboxImage();
      };
      
      const prevPhoto = () => {
        currentPhotoIndex = (currentPhotoIndex - 1 + photos.length) % photos.length;
        updateLightboxImage();
      };
      
      // Photo overlay clicks
      overlays.forEach((overlay, index) => {
        overlay.addEventListener('click', () => openLightbox(index));
      });
      
      // Lightbox controls
      const closeBtn = lightbox.querySelector('[data-testid="close-lightbox"]');
      const nextBtn = lightbox.querySelector('[data-testid="next-photo"]');
      const prevBtn = lightbox.querySelector('[data-testid="prev-photo"]');
      const backdrop = lightbox.querySelector('.lightbox-backdrop');
      
      if (closeBtn) closeBtn.addEventListener('click', closeLightbox);
      if (nextBtn) nextBtn.addEventListener('click', nextPhoto);
      if (prevBtn) prevBtn.addEventListener('click', prevPhoto);
      if (backdrop) backdrop.addEventListener('click', closeLightbox);
      
      // Keyboard navigation
      lightbox.addEventListener('keydown', (e) => {
        switch (e.key) {
          case 'Escape':
            closeLightbox();
            break;
          case 'ArrowLeft':
            prevPhoto();
            break;
          case 'ArrowRight':
            nextPhoto();
            break;
        }
      });
      
      // Make lightbox focusable
      lightbox.tabIndex = -1;
    }
    
    // Load more functionality
    const loadMoreBtns = gallery.querySelectorAll('.load-more-button');
    loadMoreBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        // Implementation would depend on data loading strategy
        console.log('Load more photos requested');
      });
    });
    
    // Share functionality
    const shareButtons = gallery.querySelectorAll('[data-testid="share-photo"]');
    shareButtons.forEach(btn => {
      btn.addEventListener('click', async (e) => {
        e.stopPropagation();
        
        const title = btn.dataset.shareTitle;
        const url = btn.dataset.shareUrl;
        
        if (navigator.share) {
          try {
            await navigator.share({
              title: `Studio Photo: ${title}`,
              text: `Check out this photo from our yoga studio: ${title}`,
              url: url
            });
          } catch (err) {
            console.log('Share cancelled or failed:', err);
          }
        } else {
          // Fallback to copy to clipboard
          try {
            await navigator.clipboard.writeText(url);
            // Could show a toast notification here
            console.log('Photo URL copied to clipboard');
          } catch (err) {
            console.log('Copy failed:', err);
          }
        }
      });
    });
    
    // Handle image loading errors
    const images = gallery.querySelectorAll('.photo-image');
    images.forEach(img => {
      img.addEventListener('error', () => {
        const photoItem = img.closest('.photo-item');
        const errorDiv = photoItem?.querySelector('.image-error');
        
        if (errorDiv) {
          img.style.display = 'none';
          errorDiv.style.display = 'flex';
        }
      });
    });
  });
});
</script>
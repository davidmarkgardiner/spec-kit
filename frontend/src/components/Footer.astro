---
// Footer component - site footer with links, contact info, and social media
// Comprehensive footer with multiple sections and accessibility features
export interface Props {
  className?: string
  variant?: 'default' | 'minimal' | 'extended'
  theme?: 'light' | 'dark'
  showSocial?: boolean
  showNewsletter?: boolean
}

const { 
  className = '', 
  variant = 'default',
  theme = 'light',
  showSocial = true,
  showNewsletter = true
} = Astro.props

// Current year for copyright
const currentYear = new Date().getFullYear()

// Navigation sections
const footerSections = {
  studio: {
    title: 'Studio',
    links: [
      { label: 'About Us', href: '/about' },
      { label: 'Our Instructors', href: '/instructors' },
      { label: 'Class Schedules', href: '/classes' },
      { label: 'Studio Tour', href: '/gallery' }
    ]
  },
  membership: {
    title: 'Membership',
    links: [
      { label: 'Pricing Plans', href: '/membership' },
      { label: 'Class Packages', href: '/membership#packages' },
      { label: 'New Student Special', href: '/membership#new-student' },
      { label: 'Corporate Wellness', href: '/corporate' }
    ]
  },
  support: {
    title: 'Support',
    links: [
      { label: 'Contact Us', href: '/contact' },
      { label: 'FAQ', href: '/faq' },
      { label: 'Class Policies', href: '/policies' },
      { label: 'Cancellation Policy', href: '/policies#cancellation' }
    ]
  }
}

// Social media links
const socialLinks = [
  { 
    platform: 'Instagram', 
    href: 'https://instagram.com/serenityyoga',
    icon: '📷',
    ariaLabel: 'Follow us on Instagram'
  },
  { 
    platform: 'Facebook', 
    href: 'https://facebook.com/serenityyoga',
    icon: '📘',
    ariaLabel: 'Follow us on Facebook'
  },
  { 
    platform: 'YouTube', 
    href: 'https://youtube.com/serenityyoga',
    icon: '📹',
    ariaLabel: 'Subscribe to our YouTube channel'
  },
  { 
    platform: 'Twitter', 
    href: 'https://twitter.com/serenityyoga',
    icon: '🐦',
    ariaLabel: 'Follow us on Twitter'
  }
]

// Studio contact information
const studioInfo = {
  name: 'Serenity Yoga Studio',
  address: {
    street: '123 Wellness Way',
    city: 'Mindful Valley',
    state: 'CA',
    zipCode: '90210'
  },
  phone: '(555) 123-YOGA',
  email: 'hello@serenityyoga.com',
  hours: 'Mon-Sun: 6:00 AM - 9:00 PM'
}
---

<footer 
  data-testid="site-footer"
  class={`site-footer ${variant} ${className} ${theme} responsive mobile`}
  role="contentinfo"
>
  {variant !== 'minimal' && (
    <div class="footer-main">
      <div class="footer-container">
        <!-- Studio Information -->
        <div class="footer-section footer-brand">
          <div class="footer-logo">
            <div class="brand-icon">🧘‍♀️</div>
            <div class="brand-text">
              <h3 class="brand-name">{studioInfo.name}</h3>
              <p class="brand-tagline">Find Your Balance</p>
            </div>
          </div>
          
          <address class="footer-address" data-testid="footer-address">
            <p class="address-line">
              {studioInfo.address.street}
            </p>
            <p class="address-line">
              {studioInfo.address.city}, {studioInfo.address.state} {studioInfo.address.zipCode}
            </p>
          </address>
          
          <div class="footer-contact" data-testid="footer-contact">
            <a 
              href={`tel:${studioInfo.phone.replace(/\D/g, '')}`}
              class="contact-link phone-link"
              aria-label={`Call us at ${studioInfo.phone}`}
            >
              📞 {studioInfo.phone}
            </a>
            <a 
              href={`mailto:${studioInfo.email}`}
              class="contact-link email-link"
              aria-label={`Email us at ${studioInfo.email}`}
            >
              ✉️ {studioInfo.email}
            </a>
          </div>
          
          <p class="footer-hours">
            <strong>Hours:</strong> {studioInfo.hours}
          </p>
        </div>

        <!-- Navigation Links -->
        {Object.entries(footerSections).map(([key, section]) => (
          <div key={key} class="footer-section footer-links">
            <h4 class="footer-section-title">{section.title}</h4>
            <ul class="footer-link-list">
              {section.links.map((link) => (
                <li key={link.href} class="footer-link-item">
                  <a 
                    href={link.href}
                    class="footer-link"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}

        <!-- Newsletter Signup -->
        {showNewsletter && (
          <div class="footer-section footer-newsletter">
            <h4 class="footer-section-title">Stay Connected</h4>
            <p class="newsletter-description">
              Get updates on new classes, workshops, and wellness tips delivered to your inbox.
            </p>
            
            <form 
              data-testid="newsletter-form"
              class="newsletter-form"
              method="POST"
              data-netlify="true"
              name="newsletter"
              aria-label="Newsletter subscription form"
            >
              <input type="hidden" name="form-name" value="newsletter" />
              
              <div class="newsletter-input-group">
                <label for="newsletter-email" class="sr-only">
                  Email address for newsletter
                </label>
                <input 
                  type="email" 
                  id="newsletter-email"
                  name="email"
                  class="newsletter-input"
                  placeholder="Enter your email"
                  required
                  aria-describedby="newsletter-privacy"
                />
                <button 
                  type="submit" 
                  class="newsletter-button"
                  aria-label="Subscribe to newsletter"
                >
                  Subscribe
                </button>
              </div>
              
              <p id="newsletter-privacy" class="newsletter-privacy">
                We respect your privacy. Unsubscribe anytime.
              </p>
            </form>
          </div>
        )}
      </div>
    </div>
  )}

  <!-- Footer Bottom -->
  <div class="footer-bottom">
    <div class="footer-container">
      <div class="footer-bottom-content">
        <!-- Copyright and Legal -->
        <div class="footer-copyright">
          <p class="copyright-text">
            © {currentYear} {studioInfo.name}. All rights reserved.
          </p>
          <div class="footer-legal">
            <a href="/privacy" class="legal-link">Privacy Policy</a>
            <span class="legal-divider">•</span>
            <a href="/terms" class="legal-link">Terms of Service</a>
            <span class="legal-divider">•</span>
            <a href="/accessibility" class="legal-link">Accessibility</a>
          </div>
        </div>

        <!-- Social Media Links -->
        {showSocial && (
          <div class="footer-social" data-testid="footer-social">
            <h4 class="social-title sr-only">Follow Us</h4>
            <div class="social-links">
              {socialLinks.map((social) => (
                <a
                  key={social.platform}
                  href={social.href}
                  class="social-link"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={social.ariaLabel}
                  data-testid={`social-${social.platform.toLowerCase()}`}
                >
                  <span class="social-icon">{social.icon}</span>
                  <span class="social-text">{social.platform}</span>
                </a>
              ))}
            </div>
          </div>
        )}

        <!-- Back to Top Button -->
        <button 
          data-testid="back-to-top"
          class="back-to-top"
          aria-label="Back to top of page"
          onclick="window.scrollTo({ top: 0, behavior: 'smooth' })"
        >
          <span class="back-to-top-icon">↑</span>
          <span class="back-to-top-text">Top</span>
        </button>
      </div>
    </div>
  </div>
</footer>

<style>
.site-footer {
  background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 50%, #cbd5e1 100%);
  color: #334155;
  margin-top: auto;
  border-top: 1px solid #e2e8f0;
  width: 100%;
  position: relative;
  clear: both;
}

.site-footer.minimal {
  background: #f9fafb;
  color: #374151;
  border-top: 1px solid #e5e7eb;
}

.footer-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 2rem;
  width: 100%;
  box-sizing: border-box;
}

/* Main Footer Section */
.footer-main {
  padding: 4rem 0 3rem 0;
  border-bottom: 1px solid #e2e8f0;
}

.footer-main .footer-container {
  display: grid;
  grid-template-columns: 1fr;
  gap: 2rem;
  width: 100%;
}

.footer-section {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

/* Footer Brand */
.footer-brand {
  max-width: 300px;
}

.footer-logo {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  margin-bottom: 1.5rem;
}

.brand-icon {
  font-size: 2.5rem;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 3rem;
  height: 3rem;
  background: linear-gradient(135deg, #7dd3fc, #38bdf8);
  border-radius: 50%;
  filter: drop-shadow(0 4px 15px rgba(125, 211, 252, 0.4));
}

.brand-name {
  font-size: 1.5rem;
  font-weight: 700;
  color: #1e293b;
  margin: 0 0 0.25rem 0;
  line-height: 1.2;
}

.brand-tagline {
  font-size: 0.875rem;
  color: #64748b;
  margin: 0;
  line-height: 1;
}

.footer-address {
  font-style: normal;
  color: #64748b;
  line-height: 1.6;
  margin-bottom: 1rem;
}

.address-line {
  margin: 0 0 0.25rem 0;
}

.footer-contact {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  margin-bottom: 1rem;
}

.contact-link {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  color: #64748b;
  text-decoration: none;
  font-size: 0.9375rem;
  transition: all 0.3s ease;
}

.contact-link:hover {
  color: #0284c7;
  transform: translateX(4px);
}

.contact-link:focus {
  outline: 2px solid #7dd3fc;
  outline-offset: 2px;
  border-radius: 0.5rem;
}

.footer-hours {
  color: #64748b;
  font-size: 0.9375rem;
  margin: 0;
  line-height: 1.5;
}

/* Footer Links */
.footer-section-title {
  font-size: 1.125rem;
  font-weight: 600;
  color: #1e293b;
  margin: 0 0 1rem 0;
  line-height: 1.3;
}

.footer-link-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.footer-link {
  color: #64748b;
  text-decoration: none;
  font-size: 0.9375rem;
  transition: all 0.3s ease;
  line-height: 1.4;
}

.footer-link:hover {
  color: #0284c7;
  padding-left: 0.5rem;
}

.footer-link:focus {
  outline: 2px solid #7dd3fc;
  outline-offset: 2px;
  border-radius: 0.5rem;
}

/* Newsletter Section */
.newsletter-description {
  color: #64748b;
  font-size: 0.9375rem;
  line-height: 1.5;
  margin: 0 0 1.5rem 0;
}

.newsletter-input-group {
  display: flex;
  gap: 0.5rem;
  margin-bottom: 0.75rem;
}

.newsletter-input {
  flex: 1;
  padding: 0.75rem 1rem;
  background: rgba(255, 255, 255, 0.9);
  border: 1px solid #cbd5e1;
  border-radius: 0.75rem;
  color: #334155;
  font-size: 0.9375rem;
  transition: all 0.3s ease;
  min-height: 44px;
  backdrop-filter: blur(10px);
}

.newsletter-input:focus {
  outline: none;
  border-color: #7dd3fc;
  box-shadow: 0 0 0 3px rgba(125, 211, 252, 0.2);
  background: rgba(255, 255, 255, 1);
}

.newsletter-input::placeholder {
  color: #94a3b8;
}

.newsletter-button {
  padding: 0.75rem 1.5rem;
  background: linear-gradient(135deg, #7dd3fc, #38bdf8);
  color: white;
  border: none;
  border-radius: 0.75rem;
  font-weight: 600;
  font-size: 0.875rem;
  cursor: pointer;
  transition: all 0.3s ease;
  text-transform: uppercase;
  letter-spacing: 0.025em;
  min-height: 44px;
  white-space: nowrap;
  box-shadow: 0 4px 15px rgba(125, 211, 252, 0.3);
}

.newsletter-button:hover {
  background: linear-gradient(135deg, #38bdf8, #0ea5e9);
  transform: translateY(-1px);
  box-shadow: 0 6px 20px rgba(125, 211, 252, 0.4);
}

.newsletter-button:focus {
  outline: 2px solid #7dd3fc;
  outline-offset: 2px;
}

.newsletter-button:active {
  transform: translateY(0);
}

.newsletter-privacy {
  font-size: 0.75rem;
  color: #9ca3af;
  margin: 0;
  line-height: 1.4;
}

/* Footer Bottom */
.footer-bottom {
  padding: 2rem 0;
  background: linear-gradient(135deg, #e2e8f0 0%, #cbd5e1 100%);
}

.footer-bottom-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1.5rem;
  text-align: center;
}

.footer-copyright {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.75rem;
}

.copyright-text {
  color: #64748b;
  font-size: 0.875rem;
  margin: 0;
}

.footer-legal {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  flex-wrap: wrap;
  justify-content: center;
}

.legal-link {
  color: #64748b;
  text-decoration: none;
  font-size: 0.875rem;
  transition: all 0.3s ease;
}

.legal-link:hover {
  color: #0284c7;
}

.legal-link:focus {
  outline: 2px solid #7dd3fc;
  outline-offset: 2px;
  border-radius: 0.5rem;
}

.legal-divider {
  color: #94a3b8;
  font-size: 0.875rem;
}

/* Social Media */
.social-links {
  display: flex;
  gap: 1rem;
  justify-content: center;
  flex-wrap: wrap;
}

.social-link {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.25rem;
  padding: 0.75rem;
  color: #64748b;
  text-decoration: none;
  border-radius: 0.75rem;
  transition: all 0.3s ease;
  min-width: 60px;
  min-height: 60px;
  background: rgba(255, 255, 255, 0.5);
  backdrop-filter: blur(10px);
}

.social-link:hover {
  color: #0284c7;
  background: rgba(255, 255, 255, 0.9);
  transform: translateY(-4px);
  box-shadow: 0 8px 25px rgba(125, 211, 252, 0.3);
}

.social-link:focus {
  outline: 2px solid #7dd3fc;
  outline-offset: 2px;
}

.social-icon {
  font-size: 1.5rem;
}

.social-text {
  font-size: 0.75rem;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.025em;
}

/* Back to Top Button */
.back-to-top {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.25rem;
  padding: 0.75rem;
  background: rgba(255, 255, 255, 0.8);
  color: #64748b;
  border: none;
  border-radius: 0.75rem;
  cursor: pointer;
  transition: all 0.3s ease;
  min-width: 60px;
  min-height: 60px;
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.3);
}

.back-to-top:hover {
  background: linear-gradient(135deg, #7dd3fc, #38bdf8);
  color: white;
  transform: translateY(-4px);
  box-shadow: 0 8px 25px rgba(125, 211, 252, 0.4);
}

.back-to-top:focus {
  outline: 2px solid #7dd3fc;
  outline-offset: 2px;
}

.back-to-top-icon {
  font-size: 1.25rem;
  font-weight: bold;
}

.back-to-top-text {
  font-size: 0.75rem;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.025em;
}

/* Screen Reader Only */
.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

/* Theme variations */
.site-footer.light {
  background: white;
  color: #374151;
}

.site-footer.light .footer-main {
  border-bottom-color: #e5e7eb;
}

.site-footer.light .footer-bottom {
  background: #f9fafb;
}

.site-footer.light .brand-name,
.site-footer.light .footer-section-title {
  color: #1f2937;
}

.site-footer.light .contact-link,
.site-footer.light .footer-link,
.site-footer.light .footer-hours,
.site-footer.light .newsletter-description {
  color: #6b7280;
}

.site-footer.light .newsletter-input {
  background: white;
  border-color: #d1d5db;
  color: #1f2937;
}

.site-footer.light .back-to-top {
  background: #f3f4f6;
  color: #6b7280;
}

/* Responsive design */
@media (min-width: 768px) {
  .footer-container {
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 3rem;
  }
  
  .newsletter-input-group {
    flex-direction: column;
    gap: 0.75rem;
  }
  
  .newsletter-button {
    align-self: flex-start;
  }
  
  .footer-bottom-content {
    flex-direction: row;
    justify-content: space-between;
    text-align: left;
  }
  
  .footer-copyright {
    align-items: flex-start;
  }
  
  .footer-legal {
    justify-content: flex-start;
  }
}

@media (min-width: 1024px) {
  .footer-main {
    padding: 4rem 0 3rem 0;
  }
  
  .footer-container {
    grid-template-columns: 1.5fr 1fr 1fr 1fr 1.2fr;
    gap: 4rem;
  }
  
  .footer-bottom {
    padding: 2rem 0;
  }
  
  .social-links {
    gap: 1.5rem;
  }
}

/* Mobile optimizations */
@media (max-width: 480px) {
  .footer-container {
    padding: 0 1rem;
  }
  
  .footer-main {
    padding: 2rem 0 1.5rem 0;
  }
  
  .footer-bottom {
    padding: 1rem 0;
  }
  
  .newsletter-input-group {
    flex-direction: column;
    gap: 0.5rem;
  }
  
  .social-links {
    gap: 0.5rem;
  }
  
  .social-link {
    min-width: 50px;
    min-height: 50px;
    padding: 0.5rem;
  }
  
  .social-icon {
    font-size: 1.25rem;
  }
  
  .footer-legal {
    flex-direction: column;
    gap: 0.5rem;
  }
  
  .legal-divider {
    display: none;
  }
}

/* Print styles */
@media print {
  .site-footer {
    background: white;
    color: #000;
    border-top: 2px solid #000;
  }
  
  .footer-social,
  .newsletter-form,
  .back-to-top {
    display: none;
  }
  
  .footer-main {
    border-bottom: 1px solid #000;
  }
  
  .footer-bottom {
    background: white;
  }
}

/* High contrast mode */
@media (prefers-contrast: high) {
  .site-footer {
    border-top: 2px solid #000;
  }
  
  .contact-link:focus,
  .footer-link:focus,
  .legal-link:focus,
  .social-link:focus,
  .newsletter-button:focus,
  .back-to-top:focus {
    outline: 3px solid #000;
  }
}

/* Reduced motion */
@media (prefers-reduced-motion: reduce) {
  .contact-link,
  .footer-link,
  .social-link,
  .newsletter-button,
  .back-to-top {
    transition: none;
  }
  
  .social-link:hover,
  .back-to-top:hover,
  .newsletter-button:hover {
    transform: none;
  }
}

/* Focus visible */
.contact-link:focus-visible,
.footer-link:focus-visible,
.legal-link:focus-visible,
.social-link:focus-visible,
.newsletter-button:focus-visible,
.back-to-top:focus-visible {
  outline: 3px solid #22c55e;
  outline-offset: 2px;
}
</style>

<script>
// Footer functionality
document.addEventListener('DOMContentLoaded', () => {
  const footers = document.querySelectorAll('[data-testid="site-footer"]');
  
  footers.forEach(footer => {
    // Newsletter form handling
    const newsletterForm = footer.querySelector('[data-testid="newsletter-form"]');
    
    if (newsletterForm) {
      newsletterForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const formData = new FormData(newsletterForm);
        const button = newsletterForm.querySelector('.newsletter-button');
        const input = newsletterForm.querySelector('.newsletter-input');
        
        if (!button || !input) return;
        
        // Show loading state
        const originalText = button.textContent;
        button.textContent = 'Subscribing...';
        button.disabled = true;
        input.disabled = true;
        
        try {
          // Submit to Netlify Forms
          await fetch('/', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams(formData).toString()
          });
          
          // Success feedback
          button.textContent = 'Subscribed!';
          button.style.background = '#22c55e';
          input.value = '';
          
          // Reset after 3 seconds
          setTimeout(() => {
            button.textContent = originalText;
            button.disabled = false;
            input.disabled = false;
            button.style.background = '';
          }, 3000);
          
        } catch (error) {
          // Error feedback
          button.textContent = 'Try Again';
          button.style.background = '#dc2626';
          
          // Reset after 3 seconds
          setTimeout(() => {
            button.textContent = originalText;
            button.disabled = false;
            input.disabled = false;
            button.style.background = '';
          }, 3000);
        }
      });
    }
    
    // Back to top button visibility
    const backToTopButton = footer.querySelector('[data-testid="back-to-top"]');
    
    if (backToTopButton) {
      const toggleBackToTop = () => {
        const scrolled = window.scrollY > 300;
        backToTopButton.style.display = scrolled ? 'flex' : 'none';
      };
      
      // Initial check
      toggleBackToTop();
      
      // Listen for scroll events
      let ticking = false;
      window.addEventListener('scroll', () => {
        if (!ticking) {
          requestAnimationFrame(() => {
            toggleBackToTop();
            ticking = false;
          });
          ticking = true;
        }
      });
    }
    
    // Social link analytics tracking (if analytics is available)
    const socialLinks = footer.querySelectorAll('[data-testid^="social-"]');
    socialLinks.forEach(link => {
      link.addEventListener('click', () => {
        const platform = link.getAttribute('data-testid')?.replace('social-', '');
        
        // Track social media clicks if analytics is available
        if (typeof gtag !== 'undefined') {
          gtag('event', 'social_click', {
            social_platform: platform,
            location: 'footer'
          });
        }
      });
    });
  });
});
</script>
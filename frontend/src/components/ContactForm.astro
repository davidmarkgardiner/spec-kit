---
// ContactForm component - handles studio contact and membership inquiries
// This component implements the contract from ContactForm.test.ts
export interface Props {
  className?: string
  variant?: 'default' | 'compact' | 'inline'
  theme?: 'light' | 'dark'
  showOptionalFields?: boolean
  formType?: 'contact' | 'membership-inquiry'
  resetOnSuccess?: boolean
  onSubmit?: (data: any) => Promise<{ success: boolean }>
}

const { 
  className = '', 
  variant = 'default',
  theme = 'light',
  showOptionalFields = false,
  formType = 'contact',
  resetOnSuccess = true,
  onSubmit
} = Astro.props

// Form field IDs for proper labeling
const nameId = `name-${Date.now()}`
const emailId = `email-${Date.now()}`
const phoneId = `phone-${Date.now()}`
const subjectId = `subject-${Date.now()}`
const messageId = `message-${Date.now()}`
const preferredContactId = `preferred-contact-${Date.now()}`
const membershipInterestId = `membership-interest-${Date.now()}`
const experienceLevelId = `experience-level-${Date.now()}`
---

<form 
  data-testid="contact-form"
  class={`contact-form ${variant} ${className} ${theme} responsive mobile`}
  role="form"
  method="POST"
  data-netlify="true"
  name={formType}
>
  <!-- Hidden Netlify form identifier -->
  <input type="hidden" name="form-name" value={formType} />
  
  <div class="form-header">
    <h2 class="form-title">
      {formType === 'membership-inquiry' ? 'Membership Inquiry' : 'Contact Us'}
    </h2>
    <p class="form-description">
      {formType === 'membership-inquiry' 
        ? 'Interested in joining our yoga community? Let us know about your experience and goals.'
        : 'Have questions about classes, schedules, or our studio? We\'d love to hear from you.'
      }
    </p>
  </div>

  <div class="form-body">
    <div class="form-row">
      <div class="form-field">
        <label for={nameId} class="field-label">
          Full Name <span class="required">*</span>
        </label>
        <input
          type="text"
          id={nameId}
          name="name"
          class="field-input"
          placeholder="Enter your first and last name"
          required
          minlength="2"
          maxlength="100"
          pattern="^[a-zA-Z\s\-\.\']+$"
          aria-describedby={`${nameId}-error`}
        />
        <div id={`${nameId}-error`} data-testid="name-error" class="field-error" role="alert"></div>
      </div>
    </div>

    <div class="form-row">
      <div class="form-field">
        <label for={emailId} class="field-label">
          Email Address <span class="required">*</span>
        </label>
        <input
          type="email"
          id={emailId}
          name="email"
          class="field-input"
          placeholder="your.email@example.com"
          required
          maxlength="254"
          aria-describedby={`${emailId}-error`}
        />
        <div id={`${emailId}-error`} data-testid="email-error" class="field-error" role="alert"></div>
      </div>
    </div>

    {showOptionalFields && (
      <div class="form-row">
        <div class="form-field">
          <label for={phoneId} class="field-label">Phone Number</label>
          <input
            type="tel"
            id={phoneId}
            name="phone"
            class="field-input"
            placeholder="(555) 123-4567"
            maxlength="20"
            pattern="^[\+]?[1-9][\d\s\-\(\)\.]{8,}$"
            aria-describedby={`${phoneId}-error`}
          />
          <div id={`${phoneId}-error`} data-testid="phone-error" class="field-error" role="alert"></div>
        </div>
      </div>
    )}

    {showOptionalFields && (
      <div class="form-row">
        <div class="form-field">
          <label for={subjectId} class="field-label">Subject</label>
          <input
            type="text"
            id={subjectId}
            name="subject"
            class="field-input"
            placeholder="What can we help you with?"
            maxlength="100"
          />
        </div>
      </div>
    )}

    {showOptionalFields && (
      <div class="form-row">
        <div class="form-field">
          <label for={preferredContactId} class="field-label">Preferred Contact Method</label>
          <select
            id={preferredContactId}
            name="preferredContact"
            class="field-input field-select"
          >
            <option value="">Select preference</option>
            <option value="email">Email</option>
            <option value="phone">Phone</option>
            <option value="either">Either</option>
          </select>
        </div>
      </div>
    )}

    {formType === 'membership-inquiry' && (
      <div class="form-row">
        <div class="form-field">
          <label for={membershipInterestId} class="field-label">
            Membership Interest
          </label>
          <select
            id={membershipInterestId}
            name="membershipInterest"
            class="field-input field-select"
          >
            <option value="">Select membership type</option>
            <option value="unlimited-monthly">Unlimited Monthly</option>
            <option value="class-packages">Class Packages</option>
            <option value="drop-in">Drop-in Classes</option>
            <option value="not-sure">Not Sure Yet</option>
          </select>
        </div>
      </div>
    )}

    {formType === 'membership-inquiry' && (
      <div class="form-row">
        <div class="form-field">
          <label for={experienceLevelId} class="field-label">
            Experience Level
          </label>
          <select
            id={experienceLevelId}
            name="experienceLevel"
            class="field-input field-select"
          >
            <option value="">Select your level</option>
            <option value="beginner">Beginner</option>
            <option value="intermediate">Intermediate</option>
            <option value="advanced">Advanced</option>
            <option value="mixed">Mixed/Varies</option>
          </select>
        </div>
      </div>
    )}

    <div class="form-row">
      <div class="form-field">
        <label for={messageId} class="field-label">
          Message <span class="required">*</span>
        </label>
        <textarea
          id={messageId}
          name="message"
          class="field-input field-textarea"
          placeholder={formType === 'membership-inquiry' 
            ? 'Tell us about your yoga goals, any questions you have, or specific needs we should know about...'
            : 'Tell us how we can help you on your yoga journey...'
          }
          required
          minlength="10"
          maxlength="2000"
          rows="5"
          aria-describedby={`${messageId}-error`}
        ></textarea>
        <div id={`${messageId}-error`} data-testid="message-error" class="field-error" role="alert"></div>
      </div>
    </div>
  </div>

  <div class="form-footer">
    <button 
      type="submit" 
      class="submit-button"
      disabled
    >
      <span class="submit-text">Send Message</span>
      <span class="submit-loading" style="display: none;">Sending...</span>
    </button>

    <div data-testid="success-message" class="success-message" style="display: none;" role="alert">
      <strong>Thank you!</strong> Your message has been received. We'll get back to you within 24 hours.
    </div>

    <div data-testid="error-message" class="error-message" style="display: none;" role="alert">
      <strong>Oops!</strong> There was a problem sending your message. Please try again or email us directly.
    </div>
  </div>
</form>

<style>
.contact-form {
  max-width: 600px;
  margin: 0 auto;
  background: white;
  border-radius: 1rem;
  padding: 2rem;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

.contact-form.compact {
  padding: 1.5rem;
  max-width: 400px;
}

.contact-form.inline {
  max-width: 100%;
  box-shadow: none;
  border: 1px solid #e5e7eb;
  padding: 1.5rem;
}

/* Form header */
.form-header {
  text-align: center;
  margin-bottom: 2rem;
  padding-bottom: 1.5rem;
  border-bottom: 2px solid #f3f4f6;
}

.form-title {
  font-size: 1.875rem;
  font-weight: 700;
  color: #1f2937;
  margin: 0 0 0.75rem 0;
  line-height: 1.3;
}

.form-description {
  font-size: 1rem;
  color: #6b7280;
  line-height: 1.6;
  margin: 0;
}

/* Form body */
.form-body {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
  margin-bottom: 2rem;
}

.form-row {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.form-field {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  position: relative;
}

.field-label {
  font-size: 0.9375rem;
  font-weight: 600;
  color: #374151;
  line-height: 1.4;
  letter-spacing: 0.025em;
}

.required {
  color: #dc2626;
  margin-left: 0.25rem;
}

.field-input {
  width: 100%;
  padding: 0.875rem 1rem;
  font-size: 1rem;
  line-height: 1.5;
  color: #1f2937;
  background: white;
  border: 2px solid #d1d5db;
  border-radius: 0.5rem;
  transition: all 0.2s ease;
  min-height: 44px; /* Touch target */
  box-sizing: border-box;
}

.field-input:focus {
  outline: none;
  border-color: #22c55e;
  box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.1);
}

.field-input:invalid {
  border-color: #dc2626;
}

.field-input:disabled {
  background: #f9fafb;
  border-color: #d1d5db;
  color: #6b7280;
  cursor: not-allowed;
}

.field-textarea {
  resize: vertical;
  min-height: 120px;
  font-family: inherit;
}

.field-select {
  cursor: pointer;
  background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 20 20'%3e%3cpath stroke='%236b7280' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M6 8l4 4 4-4'/%3e%3c/svg%3e");
  background-position: right 0.5rem center;
  background-repeat: no-repeat;
  background-size: 1.5em 1.5em;
  padding-right: 2.5rem;
}

.field-error {
  font-size: 0.875rem;
  color: #dc2626;
  font-weight: 500;
  min-height: 1.25rem;
  display: none;
}

.field-error.active {
  display: block;
}

/* Placeholder styling */
.field-input::placeholder {
  color: #9ca3af;
  font-style: italic;
}

/* Form footer */
.form-footer {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  align-items: center;
}

.submit-button {
  width: 100%;
  max-width: 300px;
  background: linear-gradient(135deg, #22c55e, #16a34a);
  color: white;
  border: none;
  border-radius: 0.75rem;
  padding: 1rem 2rem;
  font-size: 1.125rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.025em;
  cursor: pointer;
  transition: all 0.2s ease;
  min-height: 44px;
  position: relative;
  overflow: hidden;
}

.submit-button:hover:not(:disabled) {
  background: linear-gradient(135deg, #16a34a, #15803d);
  transform: translateY(-1px);
  box-shadow: 0 4px 15px rgba(34, 197, 94, 0.3);
}

.submit-button:focus {
  outline: 2px solid #22c55e;
  outline-offset: 2px;
}

.submit-button:active:not(:disabled) {
  transform: translateY(0);
  box-shadow: 0 2px 8px rgba(34, 197, 94, 0.3);
}

.submit-button:disabled {
  background: #d1d5db;
  color: #6b7280;
  cursor: not-allowed;
  transform: none;
  box-shadow: none;
}

.submit-loading {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.success-message {
  padding: 1rem 1.5rem;
  background: #f0fdf4;
  border: 1px solid #bbf7d0;
  border-radius: 0.5rem;
  color: #166534;
  font-size: 0.9375rem;
  text-align: center;
  line-height: 1.5;
}

.error-message {
  padding: 1rem 1.5rem;
  background: #fef2f2;
  border: 1px solid #fecaca;
  border-radius: 0.5rem;
  color: #dc2626;
  font-size: 0.9375rem;
  text-align: center;
  line-height: 1.5;
}

/* Theme variations */
.contact-form.dark {
  background: #1f2937;
  color: white;
}

.contact-form.dark .form-title {
  color: white;
}

.contact-form.dark .form-description {
  color: #d1d5db;
}

.contact-form.dark .field-label {
  color: #f3f4f6;
}

.contact-form.dark .field-input {
  background: #374151;
  border-color: #4b5563;
  color: white;
}

.contact-form.dark .field-input:focus {
  border-color: #22c55e;
}

.contact-form.dark .field-input::placeholder {
  color: #9ca3af;
}

.contact-form.dark .field-input:disabled {
  background: #4b5563;
  color: #9ca3af;
}

/* Responsive design */
@media (min-width: 768px) {
  .contact-form {
    padding: 2.5rem;
  }
  
  .form-row {
    flex-direction: row;
    gap: 1.5rem;
  }
  
  .form-field {
    flex: 1;
  }
  
  /* Full width fields */
  .form-field:has(.field-textarea),
  .form-field:has([name="message"]),
  .form-field:has([name="subject"]) {
    flex: 1 1 100%;
  }
}

@media (min-width: 1024px) {
  .contact-form {
    max-width: 700px;
  }
  
  .form-title {
    font-size: 2.25rem;
  }
  
  .form-description {
    font-size: 1.125rem;
  }
}

/* Mobile optimizations */
@media (max-width: 480px) {
  .contact-form {
    margin: 0 1rem;
    padding: 1.5rem;
    border-radius: 0.75rem;
  }
  
  .form-title {
    font-size: 1.5rem;
  }
  
  .field-input {
    font-size: 16px; /* Prevents zoom on iOS */
  }
  
  .submit-button {
    font-size: 1rem;
    padding: 0.875rem 1.5rem;
  }
}

/* Print styles */
@media print {
  .contact-form {
    box-shadow: none;
    border: 1px solid #000;
  }
  
  .submit-button {
    background: #000;
    color: white;
  }
}

/* High contrast mode */
@media (prefers-contrast: high) {
  .field-input {
    border-color: #000;
  }
  
  .submit-button {
    background: #000;
    border: 2px solid #000;
  }
  
  .field-input:focus {
    border-color: #000;
    outline: 2px solid #000;
  }
}

/* Reduced motion */
@media (prefers-reduced-motion: reduce) {
  .field-input,
  .submit-button {
    transition: none;
  }
  
  .submit-button:hover {
    transform: none;
  }
}

/* Focus visible */
.submit-button:focus-visible {
  outline: 3px solid #22c55e;
  outline-offset: 2px;
}

.field-input:focus-visible {
  outline: 2px solid #22c55e;
  outline-offset: 1px;
}
</style>

<script>
// Form validation and submission handling
document.addEventListener('DOMContentLoaded', () => {
  const forms = document.querySelectorAll('[data-testid="contact-form"]');
  
  forms.forEach(form => {
    const submitButton = form.querySelector('.submit-button');
    const submitText = form.querySelector('.submit-text');
    const submitLoading = form.querySelector('.submit-loading');
    const successMessage = form.querySelector('[data-testid="success-message"]');
    const errorMessage = form.querySelector('[data-testid="error-message"]');
    
    // Field references
    const nameField = form.querySelector('[name="name"]');
    const emailField = form.querySelector('[name="email"]');
    const phoneField = form.querySelector('[name="phone"]');
    const messageField = form.querySelector('[name="message"]');
    
    // Validation patterns
    const namePattern = /^[a-zA-Z\s\-\.']+$/;
    const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    const phonePattern = /^[\+]?[1-9][\d\s\-\(\)\.]{8,}$/;
    
    // Show error function
    const showError = (field, message) => {
      const errorDiv = form.querySelector(`#${field.id}-error`);
      if (errorDiv) {
        errorDiv.textContent = message;
        errorDiv.classList.add('active');
        errorDiv.style.display = 'block';
      }
      field.style.borderColor = '#dc2626';
    };
    
    // Clear error function
    const clearError = (field) => {
      const errorDiv = form.querySelector(`#${field.id}-error`);
      if (errorDiv) {
        errorDiv.textContent = '';
        errorDiv.classList.remove('active');
        errorDiv.style.display = 'none';
      }
      field.style.borderColor = '#d1d5db';
    };
    
    // Validate field function
    const validateField = (field) => {
      const value = field.value.trim();
      let isValid = true;
      
      // Clear previous errors
      clearError(field);
      
      if (field.name === 'name') {
        if (!value) {
          showError(field, 'Name is required');
          isValid = false;
        } else if (value.length < 2) {
          showError(field, 'Name must be at least 2 characters long');
          isValid = false;
        } else if (!namePattern.test(value)) {
          showError(field, 'Name contains invalid characters. Use only letters, spaces, hyphens, periods, and apostrophes');
          isValid = false;
        }
      }
      
      if (field.name === 'email') {
        if (!value) {
          showError(field, 'Email address is required');
          isValid = false;
        } else if (!emailPattern.test(value)) {
          showError(field, 'Please enter a valid email address');
          isValid = false;
        }
      }
      
      if (field.name === 'phone' && value) {
        if (!phonePattern.test(value)) {
          showError(field, 'Please enter a valid phone number');
          isValid = false;
        }
      }
      
      if (field.name === 'message') {
        if (!value) {
          showError(field, 'Message is required');
          isValid = false;
        } else if (value.length < 10) {
          showError(field, 'Message must be at least 10 characters long');
          isValid = false;
        }
      }
      
      return isValid;
    };
    
    // Check form validity
    const checkFormValidity = () => {
      const requiredFields = [nameField, emailField, messageField];
      let allValid = true;
      
      requiredFields.forEach(field => {
        if (field && !validateField(field)) {
          allValid = false;
        }
      });
      
      // Optional phone validation
      if (phoneField && phoneField.value.trim()) {
        if (!validateField(phoneField)) {
          allValid = false;
        }
      }
      
      submitButton.disabled = !allValid;
      return allValid;
    };
    
    // Add event listeners for real-time validation
    [nameField, emailField, phoneField, messageField].forEach(field => {
      if (field) {
        field.addEventListener('blur', () => validateField(field));
        field.addEventListener('input', () => {
          clearError(field);
          setTimeout(checkFormValidity, 100);
        });
      }
    });
    
    // Initial form validation check
    checkFormValidity();
    
    // Form submission handler
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      // Validate all fields
      if (!checkFormValidity()) {
        return;
      }
      
      // Show loading state
      submitButton.disabled = true;
      submitText.style.display = 'none';
      submitLoading.style.display = 'inline';
      submitButton.textContent = 'Sending...';
      
      // Disable all form fields
      const allFields = form.querySelectorAll('input, textarea, select');
      allFields.forEach(field => field.disabled = true);
      
      // Hide previous messages
      successMessage.style.display = 'none';
      errorMessage.style.display = 'none';
      
      try {
        // Prepare form data
        const formData = new FormData(form);
        const data = Object.fromEntries(formData);
        
        // Custom submit handler or default Netlify submission
        if (typeof window.onFormSubmit === 'function') {
          const result = await window.onFormSubmit(data);
          if (result.success) {
            throw new Error('Submission failed');
          }
        } else {
          // Default Netlify form submission
          const response = await fetch(form.action || '/', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams(formData).toString()
          });
          
          if (!response.ok) {
            throw new Error('Network error');
          }
        }
        
        // Success handling
        successMessage.style.display = 'block';
        
        // Reset form if requested
        if (form.dataset.resetOnSuccess !== 'false') {
          setTimeout(() => {
            form.reset();
            checkFormValidity();
          }, 2000);
        }
        
      } catch (error) {
        // Error handling
        console.error('Form submission error:', error);
        errorMessage.style.display = 'block';
        
      } finally {
        // Reset button state
        submitText.style.display = 'inline';
        submitLoading.style.display = 'none';
        submitButton.textContent = 'Send Message';
        
        // Re-enable form fields
        allFields.forEach(field => field.disabled = false);
        
        // Re-check form validity
        setTimeout(checkFormValidity, 100);
      }
    });
  });
});
</script>